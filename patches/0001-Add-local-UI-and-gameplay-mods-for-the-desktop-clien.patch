+    BoardOverlay(final CMatchUI matchUI) {
+        this.matchUI = matchUI;
+        setOpaque(false);
+        setFocusable(false);
+    }
+
+    void attach() {
+        if (attached) {
+            return;
+        }
+        final JLayeredPane lpn = Singletons.getView().getLpnDocument();
+        lpn.add(this, JLayeredPane.PALETTE_LAYER);
+        lpn.moveToBack(this);
+        setBounds(0, 0, lpn.getWidth(), lpn.getHeight());
+        lpn.addComponentListener(resizeListener);
+        Toolkit.getDefaultToolkit().addAWTEventListener(mouseWatcher, AWTEvent.MOUSE_MOTION_EVENT_MASK);
+        attached = true;
+    }
+
+    void detach() {
+        if (!attached) {
+            return;
+        }
+        timer.stop();
+        Toolkit.getDefaultToolkit().removeAWTEventListener(mouseWatcher);
+        final JLayeredPane lpn = Singletons.getView().getLpnDocument();
+        lpn.removeComponentListener(resizeListener);
+        lpn.remove(this);
+        lpn.repaint();
+        popups.clear();
+        stackItems.clear();
+        stackImages.clear();
+        stackCards.clear();
+        attached = false;
+    }
