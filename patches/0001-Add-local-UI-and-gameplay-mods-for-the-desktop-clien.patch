+
+    private void paintOpponentHands(final Graphics2D g) {
+        final GameView gv = matchUI.getGameView();
+        if (gv == null || !pref(FPref.UI_ARENA_OPPONENT_HAND)) {
+            return;
+        }
+        for (final PlayerView p : gv.getPlayers()) {
+            if (matchUI.isLocalPlayer(p)) {
+                continue;
+            }
+            final Rectangle r = fieldBounds(p);
+            final int count = p.getZoneSize(ZoneType.Hand);
+            if (r == null || count <= 0) {
+                continue;
+            }
+            final int shown = Math.min(count, MAX_BACKS);
+            final float step = BACK_WIDTH * 0.55f;
+            final float total = (shown - 1) * step + BACK_WIDTH;
+            final float x0 = r.x + (r.width - total) / 2f;
+            final int y0 = r.y - 10;
+            final float half = (shown - 1) / 2f;
+            final BufferedImage back = FSkin.getSleeveImage(p.getSleeveIndex());
+            for (int i = 0; i < shown; i++) {
+                final float t = half == 0 ? 0 : (i - half) / half;
+                final Graphics2D g2 = (Graphics2D) g.create();
+                final double x = x0 + i * step;
+                final double y = y0 - 4 * t * t;
+                // mirrored fan: the opponent holds the cards upside down across the table
+                g2.rotate(-Math.toRadians(6) * t, x + BACK_WIDTH / 2.0, y + BACK_HEIGHT / 2.0);
+                final RoundRectangle2D shape = new RoundRectangle2D.Double(x, y, BACK_WIDTH, BACK_HEIGHT, 5, 5);
+                g2.setColor(new Color(0, 0, 0, 110));
+                g2.fill(new RoundRectangle2D.Double(x + 1, y + 2, BACK_WIDTH, BACK_HEIGHT, 5, 5));
+                if (back != null) {
+                    g2.setClip(shape);
+                    g2.drawImage(back, (int) x, (int) y, BACK_WIDTH, BACK_HEIGHT, null);
+                    g2.setClip(null);
+                } else {
+                    g2.setColor(BACK_FILL);
+                    g2.fill(shape);
+                }
+                g2.setColor(new Color(0, 0, 0, 170));
+                g2.draw(shape);
+                g2.dispose();
+            }
+            final String label = String.valueOf(count);
+            g.setFont(FSkin.getBoldFont(11).getBaseFont());
+            final FontMetrics fm = g.getFontMetrics();
+            final int bw = Math.max(18, fm.stringWidth(label) + 10);
+            final int bx = Math.round(x0 + total + 4);
+            final int by = y0 + BACK_HEIGHT - 20;
+            g.setColor(new Color(15, 17, 24, 220));
+            g.fillRoundRect(bx, by, bw, 16, 16, 16);
+            g.setColor(Color.WHITE);
+            g.drawString(label, bx + (bw - fm.stringWidth(label)) / 2, by + 12);
+        }
+    }
+
+    // ---------------------------------------------------------------- stack cascade
+
+    void stackChanged() {
+        if (!attached) {
+            return;
+        }
+        final Rectangle before = stackArea;
+        stackItems.clear();
+        final GameView gv = matchUI.getGameView();
+        if (gv != null && pref(FPref.UI_ARENA_STACK_CARDS)) {
+            final FCollectionView<StackItemView> items = gv.getStack();
+            for (final StackItemView si : matchUI.isNetGame() ? items.threadSafeIterable() : items) {
+                stackItems.add(si);
+            }
+        }
+        final Set<Integer> ids = new HashSet<>();
+        for (final StackItemView si : stackItems) {
+            ids.add(si.getId());
+        }
+        stackImages.keySet().retainAll(ids);
+        if (hoveredStack >= stackItems.size()) {
+            hoveredStack = -1;
+        }
+        layoutStack();
+        if (before != null) {
+            repaint(before);
+        }
+        if (stackArea != null) {
+            repaint(stackArea);
+        }
+    }
+
+    private void layoutStack() {
+        stackCards.clear();
+        stackArea = null;
+        final Rectangle board = stackItems.isEmpty() ? null : boardBounds();
+        if (board == null) {
+            return;
+        }
+        final int shown = Math.min(STACK_MAX_SHOWN, stackItems.size());
+        final int ch = Math.max(60, Math.min(STACK_MAX_HEIGHT, Math.round(board.height * STACK_HEIGHT_SHARE)));
+        final int cw = Math.round(ch / forge.view.arcane.CardPanel.ASPECT_RATIO);
+        if (cw != stackCardWidth || ch != stackCardHeight) {
+            stackImages.clear();
+            stackCardWidth = cw;
+            stackCardHeight = ch;
+        }
+        final int dx = Math.round(cw * STACK_OFFSET_X);
+        final int dy = Math.round(ch * STACK_OFFSET_Y);
+        final int ax = board.x + board.width - cw - STACK_MARGIN;
+        int ay = seamY(board) - ch / 2 + (shown - 1) * dy / 2;
+        ay = Math.max(board.y + (shown - 1) * dy + 6, Math.min(ay, board.y + board.height - ch - STACK_LABEL_HEIGHT - 6));
+        Rectangle area = null;
+        for (int k = 0; k < shown; k++) {
+            final Rectangle r = new Rectangle(ax - k * dx, ay - k * dy, cw, ch);
+            stackCards.add(r);
+            area = area == null ? new Rectangle(r) : area.union(r);
+        }
+        final Rectangle front = stackCards.get(0);
+        final int labelWidth = Math.max(cw + 60, 180);
+        area = area.union(new Rectangle(front.x + cw / 2 - labelWidth / 2, front.y + ch + 4, labelWidth, STACK_LABEL_HEIGHT));
+        area.grow(12, 12);
+        stackArea = area;
+    }
+
+    private CachedCardImage stackImage(final StackItemView si) {
+        return stackImages.computeIfAbsent(si.getId(), id -> new CachedCardImage(si.getSourceCard(),
+                matchUI.getLocalPlayers(), stackCardWidth, stackCardHeight) {
+            @Override
+            public void onImageFetched() {
+                if (stackArea != null) {
+                    repaint(stackArea);
+                }
+            }
+        });
+    }
+
+    private void paintStack(final Graphics2D g) {
+        if (stackCards.isEmpty() || stackItems.isEmpty()) {
+            return;
+        }
+        final Graphics2D g2 = (Graphics2D) g.create();
+        if (hoveredStack >= 0) {
+            g2.setComposite(AlphaComposite.getInstance(AlphaComposite.SRC_OVER, STACK_SEE_THROUGH));
+        }
+        final int arc = Math.max(6, stackCardWidth / 10);
+        for (int k = stackCards.size() - 1; k >= 0; k--) {
+            final Rectangle r = stackCards.get(k);
+            final StackItemView si = stackItems.get(k);
+            g2.setColor(new Color(0, 0, 0, 120));
+            g2.fillRoundRect(r.x + 3, r.y + 5, r.width, r.height, arc, arc);
+            if (k == 0) {
+                g2.setStroke(new BasicStroke(3f));
+                for (int i = 3; i >= 1; i--) {
+                    g2.setColor(new Color(STACK_GLOW.getRed(), STACK_GLOW.getGreen(), STACK_GLOW.getBlue(), 200 - 50 * i));
+                    g2.drawRoundRect(r.x - 3 * i, r.y - 3 * i, r.width + 6 * i, r.height + 6 * i, arc + 6 * i, arc + 6 * i);
+                }
+            }
+            final BufferedImage img = si.getSourceCard() == null ? null : stackImage(si).getImage();
+            final Shape oldClip = g2.getClip();
+            g2.clip(new RoundRectangle2D.Double(r.x, r.y, r.width, r.height, arc, arc));
+            if (img != null) {
+                g2.drawImage(img, r.x, r.y, r.width, r.height, null);
+            } else {
+                g2.setColor(new Color(40, 42, 50));
+                g2.fillRect(r.x, r.y, r.width, r.height);
+            }
+            g2.setClip(oldClip);
+            g2.setStroke(new BasicStroke(1f));
+            g2.setColor(new Color(0, 0, 0, 200));
+            g2.drawRoundRect(r.x, r.y, r.width, r.height, arc, arc);
+        }
+        if (stackItems.size() > stackCards.size()) {
+            final Rectangle last = stackCards.get(stackCards.size() - 1);
+            final String more = "+" + (stackItems.size() - stackCards.size());
+            g2.setFont(FSkin.getBoldFont(12).getBaseFont());
+            final FontMetrics fm = g2.getFontMetrics();
+            g2.setColor(new Color(15, 17, 24, 230));
+            g2.fillRoundRect(last.x - 6, last.y - 6, fm.stringWidth(more) + 12, 18, 18, 18);
+            g2.setColor(Color.WHITE);
+            g2.drawString(more, last.x, last.y + 7);
+        }
+        paintStackLabel(g2, stackItems.get(0), stackCards.get(0));
+        g2.dispose();
+    }
+
+    private void paintStackLabel(final Graphics2D g2, final StackItemView si, final Rectangle front) {
+        final CardView card = si.getSourceCard();
+        final boolean canSee = card != null && matchUI.mayView(card);
+        final String name = canSee ? PlayFeed.cleanName(card.getCurrentState().getName()) : "Face-down card";
+        final PlayerView who = si.getActivatingPlayer();
+        final String whoName = who == null ? "" : matchUI.isLocalPlayer(who) ? "You" : who.getName();
+        final String line1 = whoName.isEmpty() ? name : whoName + " · " + name;
+        final Set<PlayerView> locals = matchUI.getLocalPlayers();
+        final List<String> you = locals != null && locals.size() == 1
+                ? Collections.singletonList(locals.iterator().next().getName()) : Collections.emptyList();
+        final String line2 = PlayFeed.truncate(PlayFeed.condense(si.getText(), canSee ? name : null, you).replace('\n', ' '), 48);
+
+        final Font f1 = FSkin.getBoldFont(12).getBaseFont();
+        final Font f2 = FSkin.getFont(11).getBaseFont();
+        final FontMetrics m1 = g2.getFontMetrics(f1);
+        final FontMetrics m2 = g2.getFontMetrics(f2);
+        final int w = Math.max(m1.stringWidth(line1), line2.isEmpty() ? 0 : m2.stringWidth(line2)) + 20;
+        final int h = line2.isEmpty() ? 22 : STACK_LABEL_HEIGHT;
+        final int x = front.x + front.width / 2 - w / 2;
+        final int y = front.y + front.height + 8;
+        g2.setColor(new Color(15, 17, 24, 230));
+        g2.fillRoundRect(x, y, w, h, 12, 12);
+        g2.setColor(STACK_GLOW);
+        g2.drawRoundRect(x, y, w, h, 12, 12);
+        g2.setRenderingHint(RenderingHints.KEY_TEXT_ANTIALIASING, RenderingHints.VALUE_TEXT_ANTIALIAS_ON);
+        g2.setFont(f1);
+        g2.setColor(Color.WHITE);
+        g2.drawString(line1, x + 10, y + 4 + m1.getAscent());
+        if (!line2.isEmpty()) {
+            g2.setFont(f2);
+            g2.setColor(new Color(200, 204, 214));
+            g2.drawString(line2, x + 10, y + 4 + m1.getHeight() + m2.getAscent() - 1);
+        }
+    }
+
+    private void onMouse(final MouseEvent e) {
+        if (!attached || stackCards.isEmpty() || !(e.getSource() instanceof Component src) || !isShowing()) {
+            return;
+        }
+        if (SwingUtilities.getWindowAncestor(src) != SwingUtilities.getWindowAncestor(this)) {
+            return;
+        }
+        final java.awt.Point p = SwingUtilities.convertPoint(src, e.getPoint(), this);
+        int hit = -1;
+        for (int k = 0; k < stackCards.size(); k++) {
+            if (stackCards.get(k).contains(p)) {
+                hit = k;
+                break;
+            }
+        }
+        if (hit != hoveredStack) {
+            hoveredStack = hit;
+            if (hit >= 0 && hit < stackItems.size() && stackItems.get(hit).getSourceCard() != null) {
+                matchUI.setCard(stackItems.get(hit).getSourceCard());
+            }
+            if (stackArea != null) {
+                repaint(stackArea);
+            }
+        }
+    }
+
+    // ---------------------------------------------------------------- common
+
+    @Override
+    protected void paintComponent(final Graphics g) {
+        if (!attached) {
+            return;
+        }
+        final Graphics2D g2 = (Graphics2D) g.create();
+        g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
+        g2.setRenderingHint(RenderingHints.KEY_INTERPOLATION, RenderingHints.VALUE_INTERPOLATION_BILINEAR);
+        final long now = System.currentTimeMillis();
+        paintOpponentHands(g2);
+        paintStack(g2);
+        paintPopups(g2, now);
+        paintBanner(g2, now);
+        g2.dispose();
+    }
+
+    private void tick() {
+        final long now = System.currentTimeMillis();
+        Rectangle dirty = null;
+        if (bannerStart >= 0) {
+            if (bannerArea != null) {
+                dirty = new Rectangle(bannerArea);
+            }
+            if (now - bannerStart > BANNER_MS) {
+                bannerStart = -1;
+            }
+        }
+        for (final Iterator<LifePopup> it = popups.iterator(); it.hasNext();) {
+            final LifePopup lp = it.next();
+            dirty = dirty == null ? lp.area() : dirty.union(lp.area());
+            if (now - lp.start > POPUP_MS) {
+                it.remove();
+            }
+        }
+        if (dirty != null) {
+            repaint(dirty);
+        }
+        if (bannerStart < 0 && popups.isEmpty()) {
+            timer.stop();
+        }
+    }
+
+    /** The player's battlefield view, or null while the match screen is still being built. */
+    private VField fieldView(final PlayerView p) {
+        try {
+            return matchUI.getFieldViewFor(p);
+        } catch (final IndexOutOfBoundsException e) {
+            return null;
+        }
+    }
+
+    private Rectangle fieldBounds(final PlayerView p) {
+        final VField field = fieldView(p);
+        final Component viewport = field == null ? null : field.getTabletop().getParent();
+        if (viewport == null || !viewport.isShowing() || !isShowing()) {
+            return null;
+        }
+        return SwingUtilities.convertRectangle(viewport.getParent(), viewport.getBounds(), this);
+    }
+
+    private Rectangle avatarBounds(final PlayerView p) {
+        final VField field = fieldView(p);
+        final Component avatar = field == null ? null : field.getAvatarArea();
+        if (avatar == null || !avatar.isShowing() || !isShowing()) {
+            return null;
+        }
+        return SwingUtilities.convertRectangle(avatar.getParent(), avatar.getBounds(), this);
+    }
+
+    private Rectangle boardBounds() {
+        final GameView gv = matchUI.getGameView();
+        if (gv == null) {
+            return null;
+        }
+        Rectangle board = null;
+        for (final PlayerView p : gv.getPlayers()) {
+            final Rectangle r = fieldBounds(p);
+            if (r != null) {
+                board = board == null ? r : board.union(r);
+            }
+        }
+        return board;
+    }
+
+    /** Y of the line between the opponent's battlefield and yours, or the board middle. */
+    private int seamY(final Rectangle board) {
+        final GameView gv = matchUI.getGameView();
+        Rectangle mine = null;
+        Rectangle theirs = null;
+        for (final PlayerView p : gv.getPlayers()) {
+            final Rectangle r = fieldBounds(p);
+            if (r == null) {
+                continue;
+            }
+            if (matchUI.isLocalPlayer(p)) {
+                mine = mine == null ? r : mine;
+            } else {
+                theirs = theirs == null ? r : theirs;
+            }
+        }
+        if (mine != null && theirs != null && theirs.y + theirs.height <= mine.y + 2) {
+            return (theirs.y + theirs.height + mine.y) / 2;
+        }
+        return board.y + board.height / 2;
+    }
+}
