+package forge.screens.match.views;
+
+import java.awt.BasicStroke;
+import java.awt.Color;
+import java.awt.FontMetrics;
+import java.awt.GradientPaint;
+import java.awt.Graphics;
+import java.awt.Graphics2D;
+import java.awt.RenderingHints;
+
+import forge.localinstance.properties.ForgePreferences.FPref;
+import forge.model.FModel;
+import forge.toolbox.FButton;
+
+/**
+ * Prompt button drawn as a large rounded pill: amber for the primary action,
+ * slate for the secondary one. Falls back to the skinned look when the
+ * "Large Action Buttons" preference is off.
+ */
+@SuppressWarnings("serial")
+public class ArenaButton extends FButton {
+    private static final Color PRIMARY_TOP = new Color(255, 190, 70);
+    private static final Color PRIMARY_BOTTOM = new Color(225, 120, 25);
+    private static final Color PRIMARY_TEXT = new Color(40, 22, 5);
+    private static final Color SECONDARY_TOP = new Color(78, 86, 104);
+    private static final Color SECONDARY_BOTTOM = new Color(42, 46, 58);
+    private static final Color SECONDARY_TEXT = new Color(235, 238, 245);
+    private static final Color OUTLINE = new Color(255, 255, 255, 70);
+    private static final Color FOCUS = new Color(255, 255, 255, 170);
+
+    private final boolean primary;
+
+    public ArenaButton(final String label, final boolean primary) {
+        super(label);
+        this.primary = primary;
+        setRolloverEnabled(true);
+    }
+
+    public static boolean isEnabledInPrefs() {
+        return FModel.getPreferences().getPrefBoolean(FPref.UI_ARENA_BUTTONS);
+    }
+
+    @Override
+    protected void paintComponent(final Graphics g) {
+        if (!isEnabledInPrefs()) {
+            super.paintComponent(g);
+            return;
+        }
+        final Graphics2D g2 = (Graphics2D) g.create();
+        g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
+        g2.setRenderingHint(RenderingHints.KEY_TEXT_ANTIALIASING, RenderingHints.VALUE_TEXT_ANTIALIAS_ON);
+
+        final int w = getWidth() - 4;
+        final int h = getHeight() - 4;
+        final int arc = h;
+        final boolean enabled = isEnabled();
+        final boolean pressed = enabled && getModel().isArmed() && getModel().isPressed();
+        final boolean hover = enabled && getModel().isRollover();
+
+        Color top = primary ? PRIMARY_TOP : SECONDARY_TOP;
+        Color bottom = primary ? PRIMARY_BOTTOM : SECONDARY_BOTTOM;
+        if (hover) {
+            top = brighter(top, 25);
+            bottom = brighter(bottom, 25);
+        }
+        if (pressed) {
+            top = brighter(top, -35);
+            bottom = brighter(bottom, -35);
+        }
+        if (!enabled) {
+            g2.setComposite(java.awt.AlphaComposite.getInstance(java.awt.AlphaComposite.SRC_OVER, 0.35f));
+        }
+
+        final int dy = pressed ? 1 : 0;
+        // shadow
+        g2.setColor(new Color(0, 0, 0, 90));
+        g2.fillRoundRect(2, 4, w, h - 1, arc, arc);
+        // body
+        g2.setPaint(new GradientPaint(0, dy, top, 0, h + dy, bottom));
+        g2.fillRoundRect(1, 1 + dy, w, h - 1, arc, arc);
+        // top sheen
+        g2.setPaint(new GradientPaint(0, dy, new Color(255, 255, 255, 70), 0, h / 2f + dy, new Color(255, 255, 255, 0)));
+        g2.fillRoundRect(3, 2 + dy, w - 4, h / 2, arc, arc);
+        g2.setStroke(new BasicStroke(1f));
+        g2.setColor(isFocusOwner() && enabled ? FOCUS : OUTLINE);
+        g2.drawRoundRect(1, 1 + dy, w, h - 1, arc, arc);
+
+        final String text = getText();
+        if (text != null && !text.isEmpty()) {
+            g2.setFont(getFont());
+            final FontMetrics fm = g2.getFontMetrics();
+            final String shown = fit(text, fm, w - arc / 2);
+            final int tx = 1 + (w - fm.stringWidth(shown)) / 2;
+            final int ty = 1 + dy + (h - fm.getHeight()) / 2 + fm.getAscent();
+            if (primary) {
+                g2.setColor(new Color(255, 230, 170, 120));
+                g2.drawString(shown, tx, ty + 1);
+            } else {
+                g2.setColor(new Color(0, 0, 0, 120));
+                g2.drawString(shown, tx, ty + 1);
+            }
+            g2.setColor(primary ? PRIMARY_TEXT : SECONDARY_TEXT);
+            g2.drawString(shown, tx, ty);
+        }
+        g2.dispose();
+    }
+
+    private static String fit(final String text, final FontMetrics fm, final int width) {
+        if (fm.stringWidth(text) <= width) {
+            return text;
+        }
+        String s = text;
+        while (s.length() > 1 && fm.stringWidth(s + "…") > width) {
+            s = s.substring(0, s.length() - 1);
+        }
+        return s + "…";
+    }
+
+    private static Color brighter(final Color c, final int amount) {
+        return new Color(clamp(c.getRed() + amount), clamp(c.getGreen() + amount), clamp(c.getBlue() + amount), c.getAlpha());
+    }
+
+    private static int clamp(final int v) {
+        return Math.max(0, Math.min(255, v));
+    }
+}
