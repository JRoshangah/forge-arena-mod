+                            repaint();
+                        }
+                    };
+        }
+
+        @Override
+        protected void paintComponent(final Graphics g) {
+            final BufferedImage img = image == null ? null : image.getImage();
+            if (img == null) {
+                g.setColor(new Color(60, 62, 70));
+                g.fillRoundRect(0, 0, THUMB_WIDTH, THUMB_HEIGHT, 8, 8);
+                return;
+            }
+            g.drawImage(img, 0, 0, THUMB_WIDTH, THUMB_HEIGHT, null);
+        }
+    }
+
+    @SuppressWarnings("serial")
+    private static final class ManaCostView extends JComponent {
+        private final ManaCost cost;
+
+        ManaCostView(final ManaCost cost) {
+            this.cost = cost;
+            final Dimension d = new Dimension(cost.getGlyphCount() * (MANA_SYMBOL_SIZE + 1), MANA_SYMBOL_SIZE + 2);
+            setPreferredSize(d);
+            setMinimumSize(d);
+        }
