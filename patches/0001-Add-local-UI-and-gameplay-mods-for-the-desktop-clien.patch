+            }
+        }
+        final int cardHeight = Math.round(cardWidth * CardPanel.ASPECT_RATIO);
+        final boolean sizeChanged = cardWidth != fanCardWidth || cardHeight != fanCardHeight;
+        fanCardWidth = cardWidth;
+        fanCardHeight = cardHeight;
+
+        final int lift = Math.round(cardHeight * FAN_LIFT);
+        final float total = (n - 1) * step + cardWidth;
+        final float startX = CardArea.GUTTER_X + Math.max(0, (availW - total) / 2f);
+        final double maxAngle = Math.min(FAN_MAX_ANGLE, n * FAN_ANGLE_PER_CARD);
+        final float half = (n - 1) / 2f;
