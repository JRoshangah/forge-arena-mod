+            // rightmost card on top
+            final int z = Math.max(0, Math.min(lastIndex, n - 1 - i));
+            if (lastIndex >= 0 && this.getComponentZOrder(panel) != z) {
+                this.setComponentZOrder(panel, z);
+            }
+            if (panel == this.getMouseDragPanel()) {
+                continue;
+            }
+            final double[] cur = fanCurrent.get(panel);
+            if (cur == null || sizeChanged) {
+                fanCurrent.put(panel, target.clone());
+                panel.setCardBounds((int) Math.round(target[0]), (int) Math.round(target[1]), cardWidth, cardHeight);
+                panel.setFanAngle(target[2]);
+            } else {
+                animate = true;
+            }
+        }
+        if (liftedPanel != null && lastIndex >= 0) {
+            this.setComponentZOrder(liftedPanel, 0);
+        }
+        fanCurrent.keySet().retainAll(panels);
+        fanTargets.keySet().retainAll(panels);
+        if (animate && !fanTimer.isRunning()) {
+            fanTimer.start();
+        }
+
+        final Dimension size = new Dimension(rect.width, rect.height);
+        if (!size.equals(this.getPreferredSize())) {
+            this.setPreferredSize(size);
