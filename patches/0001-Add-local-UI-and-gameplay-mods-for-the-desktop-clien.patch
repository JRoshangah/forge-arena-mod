+    private CardPanel getFanCardPanel(final int x, final int y) {
+        final CardPanel dragPanel = this.getMouseDragPanel();
+        if (liftedPanel != null && liftedPanel != dragPanel && liftedPanel.isDisplayEnabled()) {
+            // the raised card also owns the strip below it, so it doesn't drop while the mouse is still under it
+            final int lx = liftedPanel.getCardX();
+            if (x > lx && x < lx + liftedPanel.getCardWidth() && y > liftedPanel.getCardY()) {
+                return liftedPanel;
+            }
+        }
+        final List<CardPanel> panels = this.getCardPanels();
+        for (int i = panels.size() - 1; i >= 0; i--) {
+            final CardPanel panel = panels.get(i);
+            final int panelX = panel == dragPanel ? this.mouseDragStartX : panel.getCardX();
+            final int panelY = panel == dragPanel ? this.mouseDragStartY : panel.getCardY();
+            if (x > panelX && x < panelX + panel.getCardWidth() && y > panelY && y < panelY + panel.getCardHeight()) {
+                return panel.isDisplayEnabled() ? panel : null;
+            }
+        }
+        return null;
+    }
