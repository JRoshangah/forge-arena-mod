+            jumpButtons.put(header, btn);
+        }
+        pnlHeader.add(pnlJump, "w 80%!, gap 25px 0 0 8px");
+
+        scrContent.getVerticalScrollBar().addAdjustmentListener(e -> updateActiveSection());
+        SwingUtilities.invokeLater(this::updateActiveSection);
+    }
+
+    private void jumpTo(final Component header) {
+        if (!txtSearch.getText().isEmpty()) {
+            // a filtered view may hide the target section
+            txtSearch.setText("");
+            applySearch();
+            scrContent.validate();
+        }
+        scrContent.getVerticalScrollBar().setValue(Math.max(0, header.getY() - 6));
+    }
+
+    /** Highlights the button of the section at the top of the visible area. */
+    private void updateActiveSection() {
+        final int top = scrContent.getVerticalScrollBar().getValue() + 60;
+        final JScrollBar bar = scrContent.getVerticalScrollBar();
+        final boolean atBottom = bar.getValue() + bar.getVisibleAmount() >= bar.getMaximum() - 2;
+        Component active = null;
+        for (final Component header : jumpButtons.keySet()) {
+            if (!header.isVisible()) {
+                continue;
+            }
+            if (active == null || header.getY() <= top || atBottom) {
+                active = header;
+            }
+        }
+        for (final Map.Entry<Component, FLabel> e : jumpButtons.entrySet()) {
+            e.getValue().setBorder(e.getKey() == active ? JUMP_ACTIVE_BORDER : JUMP_IDLE_BORDER);
+        }
     }
 
