+/**
+ * Non-blocking "what just happened" feed drawn over the battlefield. Each spell,
+ * ability or nonbasic land play gets a short summary card that fades out on its own.
+ * Hovering shows the card in the detail pane and pauses the timer, the mouse wheel
+ * zooms the card, and a click dismisses it.
+ */
+public class PlayFeed {
+    public static final String POLICY_OPPONENTS = "Summary feed (non-blocking): opponents' plays";
+    public static final String POLICY_ALL = "Summary feed (non-blocking): all plays";
+
+    public static boolean isFeedPolicy(final String policy) {
+        return POLICY_OPPONENTS.equals(policy) || POLICY_ALL.equals(policy);
+    }
+
+    private static final int TOAST_WIDTH = 330;
+    private static final int THUMB_WIDTH = 50;
+    private static final int THUMB_HEIGHT = 70;
+    // toast width minus insets (16 + 10), thumbnail and gap (10), plus a little slack
+    private static final int TEXT_WIDTH = TOAST_WIDTH - 26 - THUMB_WIDTH - 10 - 4;
+    private static final int MARGIN = 12;
+    private static final int TOP_OFFSET = 40;
+    private static final int SPACING = 6;
+    private static final int MAX_TOASTS = 3;
+    private static final int MAX_SUMMARY_CHARS = 160;
+    private static final int MANA_SYMBOL_SIZE = 13;
+
+    private static final int TICK_MS = 30;
+    private static final int FADE_IN_MS = 180;
+    private static final int FADE_OUT_MS = 450;
+    private static final int MIN_LIFE_MS = 6500;
+    private static final int MAX_LIFE_MS = 13000;
+    private static final int MS_PER_CHAR = 30;
+    private static final int LINGER_AFTER_HOVER_MS = 1500;
+
+    private static final Color BG = new Color(22, 24, 30, 228);
+    private static final Color EDGE = new Color(255, 255, 255, 45);
+    private static final Color TEXT = new Color(236, 236, 240);
+    private static final Color TEXT_DIM = new Color(165, 170, 182);
+    private static final Color TEXT_TARGET = new Color(255, 196, 120);
+
+    private static final String FACE_DOWN_NAME = "a face-down card";
+
+    // Short plain-language glosses shown under the summary when the keyword appears in it.
+    private static final Map<Pattern, String> GLOSSARY = new LinkedHashMap<>();
+    static {
+        gloss("flying", "Flying: only flyers/reach can block it");
+        gloss("reach", "Reach: can block flyers");
+        gloss("trample", "Trample: extra combat damage hits the player");
+        gloss("deathtouch", "Deathtouch: any damage it deals kills");
+        gloss("lifelink", "Lifelink: its damage also gains life");
+        gloss("vigilance", "Vigilance: attacking doesn't tap it");
+        gloss("haste", "Haste: can attack/tap right away");
+        gloss("double strike", "Double strike: deals combat damage twice");
+        gloss("first strike", "First strike: deals combat damage first");
+        gloss("menace", "Menace: needs 2+ blockers");
+        gloss("hexproof", "Hexproof: opponents can't target it");
+        gloss("shroud", "Shroud: nobody can target it");
+        gloss("indestructible", "Indestructible: damage/destroy won't kill it");
+        gloss("ward", "Ward: targeting it costs extra or gets countered");
+        gloss("flash", "Flash: can be cast at instant speed");
+        gloss("defender", "Defender: can't attack");
+        gloss("prowess", "Prowess: +1/+1 when its controller casts a noncreature spell");
+        gloss("protection from", "Protection: can't be blocked, targeted, damaged or enchanted by that");
+        gloss("infect", "Infect: damages creatures with -1/-1 counters, players with poison");
+        gloss("toxic", "Toxic: combat damage to a player also gives poison");
+        gloss("wither", "Wither: damages creatures with -1/-1 counters");
+        gloss("cascade", "Cascade: casts a cheaper card from the library for free");
+        gloss("convoke", "Convoke: creatures can tap to help pay");
+        gloss("flashback", "Flashback: can be cast again from the graveyard");
+        gloss("equip", "Equip: attach to a creature you control");
+        gloss("cycling", "Cycling: discard it to draw a card");
+        gloss("scry", "Scry: look at top cards, keep or bottom them");
+        gloss("surveil", "Surveil: look at top cards, keep or bin them");
+        gloss("mills?", "Mill: top cards of library go to graveyard");
+        gloss("treasure", "Treasure: sacrifice for one mana of any color");
+        gloss("exploits?", "Exploit: may sacrifice a creature when it enters");
+    }
+    private static final int MAX_GLOSSES = 3;
+
+    // Stack text is written in third person ("Piss loses 2 life"); fix the verb once the name becomes "you".
+    private static final Map<String, String> YOU_VERB_FIX = new LinkedHashMap<>();
+    static {
+        for (final String v : new String[] {"reveal", "lose", "gain", "draw", "discard", "sacrifice", "control",
+                "mill", "put", "create", "choose", "take", "get", "exile", "return", "cast", "attack", "untap",
+                "tap", "skip", "win", "shuffle", "look", "own", "may", "pay"}) {
+            YOU_VERB_FIX.put(v + "s", v);
+        }
+        YOU_VERB_FIX.put("searches", "search");
+        YOU_VERB_FIX.put("scries", "scry");
+        YOU_VERB_FIX.put("has", "have");
+        YOU_VERB_FIX.put("is", "are");
+        YOU_VERB_FIX.put("was", "were");
+    }
+    private static final Pattern YOU_VERB = Pattern.compile("(?i)(?<![\\w])(you) ([a-z]+)(?![\\w])");
+
+    private static void gloss(final String regex, final String text) {
+        GLOSSARY.put(Pattern.compile("(?i)(?<![\\w-])" + regex + "(?![\\w-])"), text);
+    }
+
+    private final CMatchUI matchUI;
+    private final JPanel container = new JPanel(null);
+    private final List<Toast> toasts = new ArrayList<>();
+    private final ComponentListener resizeListener = new ComponentAdapter() {
+        @Override
+        public void componentResized(final java.awt.event.ComponentEvent e) {
+            layoutToasts();
+        }
+    };
+    private boolean attached;
+    private Rectangle lastAnchor;
+
+    PlayFeed(final CMatchUI matchUI) {
+        this.matchUI = matchUI;
+        container.setOpaque(false);
+    }
+
+    void attach() {
+        if (attached) {
+            return;
+        }
+        final JLayeredPane lpn = Singletons.getView().getLpnDocument();
+        lpn.add(container, JLayeredPane.PALETTE_LAYER);
+        lpn.addComponentListener(resizeListener);
+        attached = true;
+    }
+
+    void detach() {
+        if (!attached) {
+            return;
+        }
+        for (final Toast t : toasts) {
+            t.timer.stop();
+        }
+        toasts.clear();
+        container.removeAll();
+        final JLayeredPane lpn = Singletons.getView().getLpnDocument();
+        lpn.removeComponentListener(resizeListener);
+        lpn.remove(container);
+        lpn.repaint();
+        attached = false;
+    }
+
+    /** Must be called on the EDT. */
+    void showStackItem(final StackItemView si, final SpellAbilityView sa) {
+        if (!attached || si == null) {
+            return;
+        }
+        final CardView card = si.getSourceCard();
+        final boolean canSee = card != null && matchUI.mayView(card);
+        final CardStateView state = card == null ? null : card.getCurrentState();
+        final boolean isSpell = sa != null && sa.isSpell();
+        final String desc = sa == null ? null : sa.getDescription();
+        final String cardName = canSee && state != null ? cleanName(state.getName()) : null;
+        final String shownName = desc != null && desc.startsWith("Morph ") ? "a morph"
+                : cardName != null ? cardName : FACE_DOWN_NAME;
+        final PlayerView who = si.getActivatingPlayer();
+
+        final String title;
+        if (isSpell) {
+            title = subject(who) + " cast " + shownName;
+        } else if (si.isTrigger()) {
+            title = possessive(who) + " " + shownName + " triggered";
+        } else {
+            title = subject(who) + " activated " + shownName;
+        }
+
+        String raw = si.getText();
+        final boolean permanentSpell = isSpell && canSee && state != null && !state.isInstant() && !state.isSorcery();
+        if (canSee && state != null && (permanentSpell || StringUtils.isBlank(raw))) {
+            raw = state.getOracleText();
+        }
+        final String full = condense(raw, cardName, youNames());
+
+        final Toast toast = new Toast(card, title, canSee ? metaLine(state) : null,
+                full, targetsLine(si, full), glossFor(full),
+                isSpell && canSee && state != null ? state.getManaCost() : null,
+                accentFor(card, state, canSee));
+        addToast(toast);
+    }
+
+    /** Must be called on the EDT. */
+    void showLand(final CardView land) {
+        if (!attached || land == null) {
+            return;
+        }
+        final boolean canSee = matchUI.mayView(land);
+        final CardStateView state = land.getCurrentState();
+        final String cardName = canSee ? cleanName(state.getName()) : null;
+        final String title = subject(land.getController()) + " played " + (cardName != null ? cardName : FACE_DOWN_NAME);
+        final String full = canSee ? condense(state.getOracleText(), cardName, youNames()) : "";
+        addToast(new Toast(land, title, canSee ? metaLine(state) : null, full, null, glossFor(full), null,
+                accentFor(land, state, canSee)));
+    }
+
+    private void addToast(final Toast toast) {
+        while (toasts.size() >= MAX_TOASTS) {
+            removeToast(toasts.get(toasts.size() - 1));
+        }
+        toasts.add(0, toast);
+        container.add(toast);
+        layoutToasts();
+        toast.timer.start();
+    }
+
+    private void removeToast(final Toast toast) {
+        toast.timer.stop();
+        if (toasts.remove(toast)) {
+            container.remove(toast);
+            layoutToasts();
+        }
+    }
+
+    private void layoutToasts() {
+        if (!attached) {
+            return;
+        }
+        final JLayeredPane lpn = Singletons.getView().getLpnDocument();
+        final Rectangle anchor = anchorBounds(lpn);
+        lastAnchor = anchor;
+        container.setVisible(anchor != null);
+        if (anchor == null) {
+            return;
+        }
+        // left edge: the right side of the board holds the stack cascade
+        final int x = Math.max(MARGIN, anchor.x + MARGIN);
+        // start below the opponent's card-back fan along the top edge
+        final int top = Math.max(0, anchor.y + TOP_OFFSET);
+
+        int y = 0;
+        for (final Toast t : toasts) {
+            final int h = t.getPreferredSize().height;
+            t.setBounds(0, y, TOAST_WIDTH, h);
+            y += h + SPACING;
+        }
+        final int height = Math.max(0, Math.min(y, lpn.getHeight() - top - MARGIN));
+        container.setBounds(x, top, TOAST_WIDTH, height);
+        container.revalidate();
+        lpn.repaint();
+    }
+
+    /** Re-anchors when the dock layout moves or the match screen is hidden/shown. */
+    private void checkAnchor() {
+        final Rectangle anchor = anchorBounds(Singletons.getView().getLpnDocument());
+        if (!Objects.equals(anchor, lastAnchor)) {
+            layoutToasts();
+        }
+    }
+
+    /**
+     * Bounds of the first opponent's battlefield (any battlefield if every player is local),
+     * or null when the match screen isn't showing.
+     */
+    private Rectangle anchorBounds(final JLayeredPane lpn) {
+        if (matchUI.getGameView() == null) {
+            return null;
+        }
+        VField target = null;
+        for (final PlayerView p : matchUI.getGameView().getPlayers()) {
+            VField field;
+            try {
+                field = matchUI.getFieldViewFor(p);
+            } catch (final IndexOutOfBoundsException e) {
+                field = null;
+            }
+            if (field == null) {
+                continue;
+            }
+            if (!matchUI.isLocalPlayer(p)) {
+                target = field;
+                break;
+            }
+            if (target == null) {
+                target = field;
+            }
+        }
+        final Component viewport = target == null ? null : target.getTabletop().getParent();
+        if (viewport == null || !viewport.isShowing()) {
+            return null;
+        }
+        return SwingUtilities.convertRectangle(viewport.getParent(), viewport.getBounds(), lpn);
+    }
+
+    private String subject(final PlayerView p) {
+        if (p == null) {
+            return "Someone";
+        }
+        return matchUI.isLocalPlayer(p) ? "You" : p.getName();
+    }
+
+    private String possessive(final PlayerView p) {
+        if (p == null) {
+            return "A";
+        }
+        return matchUI.isLocalPlayer(p) ? "Your" : p.getName() + "'s";
+    }
+
+    /** Names that should read as "you", only when exactly one local player is at the table. */
+    private Collection<String> youNames() {
+        final Set<PlayerView> locals = matchUI.getLocalPlayers();
+        if (locals == null || locals.size() != 1) {
+            return Collections.emptyList();
+        }
+        return Collections.singletonList(locals.iterator().next().getName());
+    }
+
+    private static String metaLine(final CardStateView state) {
+        if (state == null) {
+            return null;
+        }
+        final StringBuilder sb = new StringBuilder(String.valueOf(state.getType()).replace(" - ", " — "));
+        if (state.isCreature()) {
+            sb.append("  ·  ").append(state.getPower()).append('/').append(state.getToughness());
+        }
+        if (state.isPlaneswalker() && StringUtils.isNotBlank(state.getLoyalty())) {
+            sb.append("  ·  Loyalty ").append(state.getLoyalty());
+        }
+        if (state.isBattle() && StringUtils.isNotBlank(state.getDefense())) {
+            sb.append("  ·  Defense ").append(state.getDefense());
+        }
+        return sb.toString();
+    }
+
+    private String targetsLine(final StackItemView si, final String summary) {
+        final Set<String> names = new LinkedHashSet<>();
+        for (StackItemView cur = si; cur != null; cur = cur.getSubInstance()) {
+            final FCollectionView<CardView> cards = cur.getTargetCards();
+            if (cards != null) {
+                for (final CardView c : cards) {
+                    names.add(matchUI.mayView(c) ? cleanName(c.getCurrentState().getName()) : FACE_DOWN_NAME);
+                }
+            }
+            final FCollectionView<PlayerView> players = cur.getTargetPlayers();
+            if (players != null) {
+                for (final PlayerView p : players) {
+                    names.add(matchUI.isLocalPlayer(p) ? "you" : p.getName());
+                }
+            }
+        }
+        if (names.isEmpty()) {
+            return null;
+        }
+        // Skip the line when the summary already names every target.
+        final String lower = summary.toLowerCase();
+        boolean allMentioned = true;
+        for (final String n : names) {
+            if (!lower.contains(n.toLowerCase())) {
+                allMentioned = false;
+                break;
+            }
+        }
+        return allMentioned ? null : "→ " + String.join(", ", names);
+    }
+
+    private static Color accentFor(final CardView card, final CardStateView state, final boolean canSee) {
+        final DetailColors dc = card == null || state == null || !canSee || card.isFaceDown()
+                ? DetailColors.FACE_DOWN : CardDetailUtil.getBorderColor(state, true);
+        return new Color(dc.r, dc.g, dc.b);
+    }
+
+    static String glossFor(final String text) {
+        if (StringUtils.isBlank(text)) {
+            return null;
+        }
+        final List<String> found = new ArrayList<>();
+        for (final Map.Entry<Pattern, String> e : GLOSSARY.entrySet()) {
+            if (e.getKey().matcher(text).find()) {
+                found.add(e.getValue());
+                if (found.size() == MAX_GLOSSES) {
+                    break;
+                }
+            }
+        }
+        return found.isEmpty() ? null : String.join("\n", found);
+    }
+
+    /**
+     * Shortens rules/stack text for a quick read: drops the "Card Name - " prefix and
+     * reminder text, turns the local player's name into "you", and drops the card's own
+     * name where it starts a sentence ("Lightning Bolt deals 3 damage" → "Deals 3 damage").
+     */
+    static String condense(final String text, final String cardName, final Collection<String> youNames) {
+        if (text == null) {
+            return "";
+        }
+        String t = text.replace("\r", "");
+        final boolean hasName = StringUtils.isNotEmpty(cardName);
+
+        // reminder text and card ids "(78)", then Forge's bracketed notes "[Zone Changer: X]"
+        String prev;
+        do {
+            prev = t;
+            t = t.replaceAll("[ \\t]*\\([^()]*\\)", "");
+        } while (!t.equals(prev));
+        t = t.replaceAll("[ \\t]*\\[[^\\[\\]]*\\]", "");
+
+        // stack text starts with "Card Name - "
+        if (hasName) {
+            t = t.replaceFirst("^\\s*" + Pattern.quote(cardName) + "\\s*-\\s*", "");
+        }
+
+        for (final String name : youNames) {
+            if (StringUtils.isEmpty(name)) {
+                continue;
+            }
+            final String q = Pattern.quote(name);
+            t = t.replaceAll("(?<![\\w])" + q + "'s(?![\\w])", "your");
+            t = t.replaceAll("(?<![\\w])" + q + "(?![\\w])", "you");
+            t = YOU_VERB.matcher(t).replaceAll(r -> r.group(1) + " " + YOU_VERB_FIX.getOrDefault(r.group(2).toLowerCase(), r.group(2)));
+        }
+
+        if (hasName) {
+            t = Pattern.compile("(^|[.!?][ \\t]+|\\n[ \\t]*)" + Pattern.quote(cardName) + " (?=[a-z])")
+                    .matcher(t).replaceAll("$1");
+        }
+
+        t = t.replaceAll("[ \\t]+", " ");
+        t = t.replaceAll("[ \\t]*\\n[ \\t\\n]*", "\n");
+        t = t.replaceAll(" +([.,;:])", "$1");
+        t = t.trim();
+
+        final Matcher m = Pattern.compile("(^|[.!?] |\\n)([a-z])").matcher(t);
+        final StringBuilder sb = new StringBuilder();
+        while (m.find()) {
+            m.appendReplacement(sb, Matcher.quoteReplacement(m.group(1) + m.group(2).toUpperCase()));
+        }
+        m.appendTail(sb);
+        return sb.toString();
+    }
+
+    /** Drops Forge's internal card ids, e.g. "Chancellor of the Forge (80)'s Effect". */
+    static String cleanName(final String name) {
+        return name == null ? null : name.replaceAll("\\s*\\(\\d+\\)", "").trim();
+    }
+
+    static String truncate(final String s, final int max) {
+        if (s == null || s.length() <= max) {
+            return s;
+        }
+        int cut = s.lastIndexOf(' ', max - 1);
+        if (cut < max * 2 / 3) {
+            cut = max - 1;
+        }
+        return s.substring(0, cut).replaceAll("[\\s,;:.]+$", "") + "…";
+    }
+
+    private static String html(final String s, final int width) {
+        final String body = s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("\n", "<br>");
+        return "<html><body style='width:" + cssWidth(width) + "px'>" + body + "</body></html>";
+    }
+
+    /** Swing's HTML renderer treats CSS px as 1/72 inch, so convert real pixels. */
+    private static int cssWidth(final int pixels) {
+        int dpi = 96;
+        try {
+            dpi = java.awt.Toolkit.getDefaultToolkit().getScreenResolution();
+        } catch (final java.awt.HeadlessException ignored) {
+        }
+        return Math.max(1, pixels * 72 / Math.max(72, dpi));
+    }
+
+    private static JLabel label(final String text, final FSkin.SkinFont font, final Color color, final int width) {
+        final JLabel l = new JLabel();
+        l.setFont(font.getBaseFont());
+        l.setForeground(color);
+        l.setText(html(text, width));
+        return l;
+    }
+
+    @SuppressWarnings("serial")
+    private final class Toast extends JPanel {
+        private final CardView card;
+        private final Color accent;
+        private final int lifeMs;
+        private final Timer timer;
+        private int elapsedMs;
+        private boolean hovered;
+        private float alpha;
+
+        Toast(final CardView card, final String title, final String meta, final String fullText,
+                final String targets, final String glossary, final ManaCost cost, final Color accent) {
+            super(new MigLayout("insets 7 16 7 10, gap 10 1, hidemode 3", "[" + THUMB_WIDTH + "!][grow, fill]"));
+            this.card = card;
+            this.accent = accent;
+            setOpaque(false);
+
+            final String summary = truncate(fullText, MAX_SUMMARY_CHARS);
+            this.lifeMs = Math.max(MIN_LIFE_MS, Math.min(MAX_LIFE_MS, MIN_LIFE_MS + MS_PER_CHAR * summary.length()));
+
+            add(new Thumb(card), "spany, aligny top, w " + THUMB_WIDTH + "!, h " + THUMB_HEIGHT + "!");
+            if (cost != null && !cost.isNoCost() && !cost.isZero()) {
+                add(label(title, FSkin.getBoldFont(12), TEXT, TEXT_WIDTH - cost.getGlyphCount() * (MANA_SYMBOL_SIZE + 1) - 6), "split 2, growx");
+                add(new ManaCostView(cost), "aligny top, wrap");
+            } else {
+                add(label(title, FSkin.getBoldFont(12), TEXT, TEXT_WIDTH), "growx, wrap");
+            }
+            if (meta != null) {
+                add(label(meta, FSkin.getItalicFont(11), TEXT_DIM, TEXT_WIDTH), "growx, wrap");
+            }
+            if (StringUtils.isNotBlank(summary)) {
+                add(label(summary, FSkin.getFont(11), TEXT, TEXT_WIDTH), "growx, gaptop 3, wrap");
+            }
+            if (targets != null) {
+                add(label(targets, FSkin.getBoldFont(11), TEXT_TARGET, TEXT_WIDTH), "growx, gaptop 2, wrap");
+            }
+            if (glossary != null) {
+                add(label(glossary, FSkin.getItalicFont(10), TEXT_DIM, TEXT_WIDTH), "growx, gaptop 3, wrap");
+            }
+            if (!StringUtils.equals(summary, fullText)) {
+                setToolTipText(html(fullText, 320));
+            }
+
+            final MouseAdapter mouse = new MouseAdapter() {
+                @Override
+                public void mouseEntered(final MouseEvent e) {
+                    hovered = true;
+                    if (Toast.this.card != null) {
+                        matchUI.setCard(Toast.this.card);
+                    }
+                }
+
+                @Override
+                public void mouseExited(final MouseEvent e) {
+                    hovered = false;
+                    elapsedMs = Math.min(elapsedMs, lifeMs - LINGER_AFTER_HOVER_MS);
+                }
+
+                @Override
+                public void mouseClicked(final MouseEvent e) {
+                    hovered = false;
+                    elapsedMs = Math.max(elapsedMs, lifeMs - FADE_OUT_MS);
+                }
+
+                @Override
+                public void mouseWheelMoved(final MouseWheelEvent e) {
+                    if (e.getWheelRotation() < 0 && Toast.this.card != null && matchUI.mayView(Toast.this.card)) {
+                        CardZoomer.SINGLETON_INSTANCE.setCard(Toast.this.card.getCurrentState(), false);
+                        CardZoomer.SINGLETON_INSTANCE.doMouseWheelZoom();
+                    }
+                }
+            };
+            addMouseListener(mouse);
+            addMouseWheelListener(mouse);
+
+            timer = new Timer(TICK_MS, e -> tick());
+        }
+
+        private void tick() {
+            if (toasts.indexOf(this) == 0) {
+                checkAnchor();
+            }
+            if (!hovered) {
+                elapsedMs += TICK_MS;
+            }
+            if (elapsedMs >= lifeMs) {
+                removeToast(this);
+                return;
+            }
+            final float newAlpha;
+            if (hovered) {
+                newAlpha = 1f;
+            } else if (elapsedMs < FADE_IN_MS) {
+                newAlpha = elapsedMs / (float) FADE_IN_MS;
+            } else if (elapsedMs > lifeMs - FADE_OUT_MS) {
+                newAlpha = (lifeMs - elapsedMs) / (float) FADE_OUT_MS;
+            } else {
+                newAlpha = 1f;
+            }
+            if (newAlpha != alpha) {
+                alpha = Math.max(0f, Math.min(1f, newAlpha));
+                repaint();
+            }
+        }
+
+        @Override
+        public void paint(final Graphics g) {
+            if (alpha <= 0f) {
+                return;
+            }
+            final Graphics2D g2 = (Graphics2D) g.create();
+            g2.setComposite(AlphaComposite.getInstance(AlphaComposite.SRC_OVER, alpha));
+            super.paint(g2);
+            g2.dispose();
+        }
+
+        @Override
+        protected void paintComponent(final Graphics g) {
+            final Graphics2D g2 = (Graphics2D) g.create();
+            g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
+            final int w = getWidth();
+            final int h = getHeight();
+            // soft shadow
+            g2.setColor(new Color(0, 0, 0, 60));
+            g2.fillRoundRect(2, 3, w - 3, h - 3, 14, 14);
+            g2.setColor(BG);
+            g2.fillRoundRect(0, 0, w - 3, h - 3, 14, 14);
+            g2.setClip(0, 0, 6, h - 3);
+            g2.setColor(accent);
+            g2.fillRoundRect(0, 0, 14, h - 3, 14, 14);
+            g2.setClip(null);
+            g2.setColor(EDGE);
+            g2.setStroke(new BasicStroke(1f));
+            g2.drawRoundRect(0, 0, w - 4, h - 4, 14, 14);
+            g2.dispose();
+        }
+    }
+
+    @SuppressWarnings("serial")
+    private final class Thumb extends JComponent {
+        private final CachedCardImage image;
+
+        Thumb(final CardView card) {
+            image = card == null ? null
+                    : new CachedCardImage(card, matchUI.getLocalPlayers(), THUMB_WIDTH, THUMB_HEIGHT) {
+                        @Override
