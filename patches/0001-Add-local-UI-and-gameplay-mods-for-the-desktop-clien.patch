+    // ---------------------------------------------------------------- turn banner
+
+    void turnChanged(final PlayerView player) {
+        final GameView gv = matchUI.getGameView();
+        if (!attached || player == null || gv == null || gv.isGameOver() || !pref(FPref.UI_ARENA_TURN_BANNER)) {
+            return;
+        }
+        final boolean mine = matchUI.isLocalPlayer(player);
+        bannerTitle = mine && matchUI.getLocalPlayerCount() == 1 ? "YOUR TURN" : (player.getName() + "'s turn").toUpperCase();
+        bannerSubtitle = "Turn " + gv.getTurn();
+        bannerAccent = mine ? BANNER_MINE : BANNER_THEIRS;
+        bannerStart = System.currentTimeMillis();
+        final Rectangle board = boardBounds();
+        if (board != null) {
+            final int seam = seamY(board);
+            bannerArea = new Rectangle(board.x, seam - BANNER_HEIGHT / 2 - 6, board.width, BANNER_HEIGHT + 12);
+        }
+        timer.start();
+    }
+
+    private void paintBanner(final Graphics2D g, final long now) {
+        if (bannerStart < 0 || bannerArea == null) {
+            return;
+        }
+        final float t = (now - bannerStart) / (float) BANNER_MS;
+        if (t >= 1f) {
+            return;
+        }
+        final float alpha = t < 0.12f ? t / 0.12f : t > 0.75f ? (1f - t) / 0.25f : 1f;
+        final float slide = t < 0.12f ? 1f - t / 0.12f : 0f;
+        final Graphics2D g2 = (Graphics2D) g.create();
+        g2.setComposite(AlphaComposite.getInstance(AlphaComposite.SRC_OVER, Math.max(0f, Math.min(1f, alpha))));
+
+        final int x = bannerArea.x;
+        final int w = bannerArea.width;
+        final int y = bannerArea.y + 6;
+        final float[] stops = {0f, 0.22f, 0.78f, 1f};
+        final Color clear = new Color(0, 0, 0, 0);
+        g2.setPaint(new LinearGradientPaint(x, 0, x + w, 0, stops, new Color[] {clear, BANNER_BG, BANNER_BG, clear}));
+        g2.fillRect(x, y, w, BANNER_HEIGHT);
+        final Color accentClear = new Color(bannerAccent.getRed(), bannerAccent.getGreen(), bannerAccent.getBlue(), 0);
+        g2.setPaint(new LinearGradientPaint(x, 0, x + w, 0, stops, new Color[] {accentClear, bannerAccent, bannerAccent, accentClear}));
+        g2.fillRect(x, y, w, 2);
+        g2.fillRect(x, y + BANNER_HEIGHT - 2, w, 2);
+
+        final int shift = Math.round(-slide * 80);
+        final Font titleFont = FSkin.getBoldFont(30).getBaseFont();
+        final Font subFont = FSkin.getFont(13).getBaseFont();
+        g2.setRenderingHint(RenderingHints.KEY_TEXT_ANTIALIASING, RenderingHints.VALUE_TEXT_ANTIALIAS_ON);
+        g2.setFont(titleFont);
+        FontMetrics fm = g2.getFontMetrics();
+        final int titleY = y + 8 + fm.getAscent();
+        final int titleX = x + (w - fm.stringWidth(bannerTitle)) / 2 + shift;
+        g2.setColor(new Color(0, 0, 0, 160));
+        g2.drawString(bannerTitle, titleX + 2, titleY + 2);
+        g2.setColor(Color.WHITE);
+        g2.drawString(bannerTitle, titleX, titleY);
+        g2.setFont(subFont);
+        fm = g2.getFontMetrics();
+        g2.setColor(bannerAccent);
+        g2.drawString(bannerSubtitle, x + (w - fm.stringWidth(bannerSubtitle)) / 2 + shift, titleY + 6 + fm.getAscent());
+        g2.dispose();
+    }
+
+    // ---------------------------------------------------------------- life popups
+
+    void livesChanged(final Iterable<PlayerView> players) {
+        final GameView gv = matchUI.getGameView();
+        final boolean started = gv != null && gv.getTurn() >= 1;
+        final boolean show = attached && started && pref(FPref.UI_ARENA_LIFE_POPUPS);
+        final long now = System.currentTimeMillis();
+        for (final PlayerView p : players) {
+            final int life = p.getLife();
+            final Integer prev = lastLife.put(p.getId(), life);
+            if (!show || prev == null || prev == life) {
+                continue;
+            }
+            final Rectangle avatar = avatarBounds(p);
+            if (avatar == null) {
+                continue;
+            }
+            LifePopup merged = null;
+            for (final LifePopup lp : popups) {
+                if (lp.playerId == p.getId() && now - lp.start < POPUP_MERGE_MS) {
+                    merged = lp;
+                }
+            }
+            if (merged != null) {
+                merged.delta += life - prev;
+                merged.start = now;
+            } else {
+                popups.add(new LifePopup(p.getId(), avatar, life - prev, now));
+            }
+            timer.start();
+        }
+    }
+
+    private static final class LifePopup {
+        final int playerId;
+        final Rectangle anchor;
+        int delta;
+        long start;
+
+        LifePopup(final int playerId, final Rectangle anchor, final int delta, final long start) {
+            this.playerId = playerId;
+            this.anchor = anchor;
+            this.delta = delta;
+            this.start = start;
+        }
+
+        Rectangle area() {
+            final int cx = anchor.x + anchor.width / 2;
+            final int cy = anchor.y + anchor.height / 2;
+            return new Rectangle(cx - 70, cy - POPUP_RISE - 40, 140, POPUP_RISE + 80);
+        }
+    }
+
+    private void paintPopups(final Graphics2D g, final long now) {
+        for (final LifePopup lp : popups) {
+            if (lp.delta == 0) {
+                continue;
+            }
+            final float t = (now - lp.start) / (float) POPUP_MS;
+            if (t >= 1f) {
+                continue;
+            }
+            final float alpha = t < 0.7f ? 1f : (1f - t) / 0.3f;
+            final float scale = t < 0.15f ? 1.35f - 0.35f * (t / 0.15f) : 1f;
+            final String text = (lp.delta > 0 ? "+" : "−") + Math.abs(lp.delta);
+            final Font font = FSkin.getBoldFont(30).getBaseFont();
+            final Graphics2D g2 = (Graphics2D) g.create();
+            g2.setComposite(AlphaComposite.getInstance(AlphaComposite.SRC_OVER, Math.max(0f, alpha)));
+            final TextLayout layout = new TextLayout(text, font, g2.getFontRenderContext());
+            final Rectangle bounds = layout.getBounds().getBounds();
+            final double cx = lp.anchor.getCenterX();
+            final double cy = lp.anchor.getCenterY() - t * POPUP_RISE;
+            final AffineTransform at = new AffineTransform();
+            at.translate(cx, cy);
+            at.scale(scale, scale);
+            at.translate(-bounds.getCenterX(), -bounds.getCenterY());
+            final Shape outline = layout.getOutline(at);
+            g2.setStroke(new BasicStroke(4f, BasicStroke.CAP_ROUND, BasicStroke.JOIN_ROUND));
+            g2.setColor(new Color(0, 0, 0, 200));
+            g2.draw(outline);
+            g2.setColor(lp.delta > 0 ? LIFE_GAIN : LIFE_LOSS);
+            g2.fill(outline);
+            g2.dispose();
+        }
+    }
+
+    // ---------------------------------------------------------------- opponent hands
+
+    void handsChanged() {
+        if (!attached) {
+            return;
+        }
+        final GameView gv = matchUI.getGameView();
+        if (gv == null) {
+            return;
+        }
+        for (final PlayerView p : gv.getPlayers()) {
+            if (matchUI.isLocalPlayer(p)) {
+                continue;
+            }
+            final Rectangle r = fieldBounds(p);
+            if (r != null) {
+                repaint(r.x, r.y - BACK_HEIGHT, r.width, BACK_HEIGHT * 3);
+            }
+        }
