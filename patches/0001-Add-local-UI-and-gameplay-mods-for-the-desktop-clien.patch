@@ -0,0 +1,29 @@
+package forge.game.mulligan;
+
+import forge.game.player.Player;
+
+/**
+ * House rule: shuffle the hand away and draw a full new one as many times as you like,
+ * never putting cards on the bottom. AI players stop after a few tries so a deck the
+ * AI never likes can't stall the game start.
+ */
+public class FriendlyMulligan extends AbstractMulligan {
+    public static final int AI_MULLIGAN_CAP = 3;
+
+    public FriendlyMulligan(Player p, boolean firstMullFree) {
+        super(p, firstMullFree);
+    }
+
+    @Override
+    public boolean canMulligan() {
+        if (kept) {
+            return false;
+        }
+        return !player.isAI() || timesMulliganed < AI_MULLIGAN_CAP;
+    }
+
+    @Override
+    public int handSizeAfterNextMulligan() {
+        return player.getMaxHandSize();
+    }
+}
