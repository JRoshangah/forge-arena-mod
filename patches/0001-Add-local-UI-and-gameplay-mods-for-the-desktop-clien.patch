+        for (int i = 0; i < n; i++) {
+            final CardPanel panel = panels.get(i);
+            final float t = half == 0 ? 0 : (i - half) / half;
+            final double[] target = {
+                    startX + i * step,
+                    CardArea.GUTTER_Y + lift + FAN_ARC * cardHeight * t * t,
+                    maxAngle * t };
+            if (panel == liftedPanel) {
+                target[1] = CardArea.GUTTER_Y;
+                target[2] = 0;
+            }
+            fanTargets.put(panel, target);
