+    private void stepFan() {
+        boolean moving = false;
+        for (final Map.Entry<CardPanel, double[]> e : fanTargets.entrySet()) {
+            final CardPanel panel = e.getKey();
+            final double[] cur = fanCurrent.get(panel);
+            if (cur == null || panel == this.getMouseDragPanel()) {
+                continue;
+            }
+            final double[] target = e.getValue();
+            for (int k = 0; k < 3; k++) {
+                final double d = target[k] - cur[k];
+                if (Math.abs(d) > (k == 2 ? 0.002 : 0.5)) {
+                    cur[k] += d * FAN_TWEEN;
+                    moving = true;
+                } else {
+                    cur[k] = target[k];
+                }
+            }
+            panel.setCardBounds((int) Math.round(cur[0]), (int) Math.round(cur[1]), fanCardWidth, fanCardHeight);
+            panel.setFanAngle(cur[2]);
+        }
+        if (!moving) {
+            fanTimer.stop();
+        }
+    }
