From ccd2903fe6345467462ab788fb60acf8bca325fd Mon Sep 17 00:00:00 2001
From: jrosha <114847463+JRoshangah@users.noreply.github.com>
Date: Thu, 17 Sep 2026 13:16:31 -0400
Subject: [PATCH 5/7] Add a setting to turn off the commander damage loss rule

Settings > Gameplay > Commander Damage Loss (on by default). When off,
21 combat damage from one commander no longer loses the game; damage is
still tracked and shown. The rule is copied into GameRules when a match
starts, so it applies to every game mode, and the AI stops treating
commander damage as lethal when blocking.
---
 forge-ai/src/main/java/forge/ai/ComputerUtilCombat.java   | 3 +++
 forge-game/src/main/java/forge/game/GameRules.java        | 8 ++++++++
 forge-game/src/main/java/forge/game/player/Player.java    | 2 +-
 .../forge/screens/home/settings/CSubmenuPreferences.java  | 1 +
 .../forge/screens/home/settings/VSubmenuPreferences.java  | 8 ++++++++
 .../src/main/java/forge/gamemodes/match/HostedMatch.java  | 2 ++
 .../forge/localinstance/properties/ForgePreferences.java  | 1 +
 7 files changed, 24 insertions(+), 1 deletion(-)

diff --git a/forge-ai/src/main/java/forge/ai/ComputerUtilCombat.java b/forge-ai/src/main/java/forge/ai/ComputerUtilCombat.java
index 0c917c4645..a6ae5e9838 100644
--- a/forge-ai/src/main/java/forge/ai/ComputerUtilCombat.java
+++ b/forge-ai/src/main/java/forge/ai/ComputerUtilCombat.java
@@ -366,6 +366,9 @@ public class ComputerUtilCombat {
 
     public static List<Card> getLifeThreateningCommanders(final Player ai, final Combat combat) {
         List<Card> res = Lists.newArrayList();
+        if (!ai.getGame().getRules().hasCommanderDamageLoss()) {
+            return res;
+        }
         for (Card c : combat.getAttackers()) {
             if (c.isCommander() && combat.isAttacking(c, ai)) {
                 int currentCommanderDamage = ai.getCommanderDamage(c);
diff --git a/forge-game/src/main/java/forge/game/GameRules.java b/forge-game/src/main/java/forge/game/GameRules.java
