     private boolean manaBurn;
     private boolean orderCombatants;
+    private boolean commanderDamageLoss = true; // rule 903.10a: 21 combat damage from one commander
     private int poisonCountersToLose = 10; // is commonly 10, but turns into 15 for 2HG
     private int gamesPerMatch = 3;
     private int gamesToWinMatch = 2;
@@ -40,6 +41,13 @@ public class GameRules {
         this.manaBurn = manaBurn;
     }
 
+    public boolean hasCommanderDamageLoss() {
+        return commanderDamageLoss;
+    }
+    public void setCommanderDamageLoss(final boolean commanderDamageLoss) {
+        this.commanderDamageLoss = commanderDamageLoss;
+    }
