@@ -66,9 +72,64 @@ public final class ArenaFrame {
     static final EDocID[] DRAWER_DOCS = {
             EDocID.REPORT_STACK, EDocID.REPORT_COMBAT, EDocID.REPORT_LOG, EDocID.REPORT_DEPENDENCIES };
 
+    /** The only docs a saved board-first layout may hold, one cell each. */
+    private static final Set<String> LAYOUT_DOCS = Set.of(
+            "FIELD_0", "FIELD_1", "HAND_0", "CARD_PICTURE", "CARD_DETAIL", "REPORT_MESSAGE");
+    private static final Pattern DOC_TAG = Pattern.compile("<doc>\\s*([A-Z_0-9]+)\\s*</doc>");
+    private static final Pattern CELL_TAG = Pattern.compile("<cell[\\s>]");
+
     /** True when the board-first layout is switched on and its default layout file is available. */
     public static boolean isRequested() {
-        return FModel.getPreferences().getPrefBoolean(FPref.UI_ARENA_LAYOUT) && ensureDefaultLayout();
+        if (!FModel.getPreferences().getPrefBoolean(FPref.UI_ARENA_LAYOUT) || !ensureDefaultLayout()) {
+            return false;
+        }
+        discardInvalidUserLayout();
+        return true;
+    }
+
+    /**
+     * A layout saved during a multiplayer game or with a docked zone has extra cells; loading it
+     * into a two-player game leaves odd gaps, so fall back to the designed layout instead.
+     */
+    private static void discardInvalidUserLayout() {
+        final File file = new File(LAYOUT_FILE.userPrefLoc);
+        if (!file.exists()) {
+            return;
+        }
+        try {
+            final String xml = Files.readString(file.toPath(), StandardCharsets.UTF_8);
+            final List<String> docs = new ArrayList<>();
+            final Matcher m = DOC_TAG.matcher(xml);
+            while (m.find()) {
+                docs.add(m.group(1));
+            }
+            int cells = 0;
+            final Matcher c = CELL_TAG.matcher(xml);
+            while (c.find()) {
+                cells++;
+            }
+            if (!isDesignedLayout(docs, cells)) {
+                Files.delete(file.toPath());
+                System.out.println("Board-first layout: reset " + file + " (it held " + docs + ")");
+            }
+        } catch (final IOException e) {
+            System.err.println("Board-first layout: could not check " + file + ": " + e.getMessage());
+        }
+    }
+
+    private static boolean isDesignedLayout(final List<String> docs, final int cells) {
+        return cells == LAYOUT_DOCS.size() && docs.size() == LAYOUT_DOCS.size() && new HashSet<>(docs).equals(LAYOUT_DOCS);
+    }
+
+    /** Called before saving: only the designed six-cell arrangement (with the user's sizes) is kept. */
+    public static boolean isSavable(final List<DragCell> cells) {
+        final List<String> docs = new ArrayList<>();
+        for (final DragCell cell : cells) {
+            for (final IVDoc<? extends ICDoc> doc : cell.getDocs()) {
+                docs.add(doc.getDocumentID().name());
+            }
+        }
+        return isDesignedLayout(docs, cells.size());
     }
 
     private static boolean ensureDefaultLayout() {
