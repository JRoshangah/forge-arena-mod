+    /** Picks the most columns whose buttons still fit, then evens out the rows (6+5 rather than 10+1). */
+    private void fitJumpButtons() {
+        final int available = (int) (pnlHeader.getWidth() * 0.8);
+        if (available <= 0 || jumpButtons.isEmpty()) {
+            return;
+        }
+        int widest = 0;
+        for (final FLabel btn : jumpButtons.values()) {
+            widest = Math.max(widest, btn.getPreferredSize().width + JUMP_TEXT_PADDING);
+        }
+        final int count = jumpButtons.size();
+        final int maxColumns = Math.max(1, Math.min(count, (available + JUMP_GAP) / (widest + JUMP_GAP)));
+        final int rows = (count + maxColumns - 1) / maxColumns;
+        final int columns = (count + rows - 1) / rows;
+        if (columns != jumpColumns) {
+            layoutJumpButtons(columns);
+            pnlHeader.revalidate();
+        }
+    }
+
+    private void layoutJumpButtons(final int columns) {
+        jumpColumns = columns;
+        pnlJump.removeAll();
+        pnlJump.setLayout(new MigLayout("insets 0, gap " + JUMP_GAP + "px " + JUMP_GAP + "px, wrap " + columns + ", fillx"));
+        for (final FLabel btn : jumpButtons.values()) {
+            pnlJump.add(btn, "h 26px!, w 0:0:max, growx, sg jump");
+        }
+    }
