+/**
+ * Board-first battlefield: the play area fills the cell, a player plate sits in a reserved strip
+ * on its left edge, and your battlefield also carries the phase bar along its top.
+ */
+@SuppressWarnings("serial")
+public class ArenaFieldPanel extends JPanel {
+    static final int PLATE_WIDTH = 104;
+    private static final int PLATE_MARGIN = 8;
+    /** Width of the strip on the left of each board kept for the player plate. */
+    public static final int RESERVED_LEFT = PLATE_WIDTH + PLATE_MARGIN + 4;
+    private static final float MAX_CARD_WIDTH_SHARE = 0.5f;
+
+    static final Color GOLD = new Color(217, 168, 67);
+    static final Color RING_YOU = new Color(45, 105, 175);
+    static final Color RING_OPPONENT = new Color(170, 55, 50);
+    static final Color TEXT = new Color(233, 237, 245);
+    static final Color MUTED = new Color(142, 155, 182);
+
+    private final VField field;
+    private final Plate plate;
+    private final ArenaPhaseBar phaseBar;
+
+    ArenaFieldPanel(final VField field, final Plate plate, final ArenaPhaseBar phaseBar) {
+        super(null);
+        this.field = field;
+        this.plate = plate;
+        this.phaseBar = phaseBar;
+        setOpaque(false);
+        // first added paints on top
+        add(plate);
+        if (phaseBar != null) {
+            add(phaseBar);
+        }
+        add(field.getScroller());
+    }
+
+    /** Children overlap, so Swing must not assume it can paint them independently. */
+    @Override
+    public boolean isOptimizedDrawingEnabled() {
+        return false;
+    }
+
+    @Override
+    public void doLayout() {
+        final int w = getWidth();
+        final int h = getHeight();
+        final int top = phaseBar != null ? ArenaPhaseBar.HEIGHT : 0;
+        if (phaseBar != null) {
+            phaseBar.setBounds(0, 0, w, top);
+        }
+        field.getScroller().setBounds(0, top, w, Math.max(0, h - top));
+
+        final int plateH = Math.min(plate.getPreferredSize().height, Math.max(0, h - top - 2 * PLATE_MARGIN));
+        final int plateY = field.isMirror() ? top + PLATE_MARGIN : h - plateH - PLATE_MARGIN;
+        plate.setBounds(PLATE_MARGIN, plateY, PLATE_WIDTH, plateH);
+        field.getTabletop().setReservedLeft(RESERVED_LEFT);
+        // keep a lone card from filling the whole board
+        final int maxCardWidth = Math.max(80, Math.round((h - top) * MAX_CARD_WIDTH_SHARE));
+        if (field.getTabletop().getCardWidthMax() != maxCardWidth) {
+            field.getTabletop().setCardWidthMax(maxCardWidth);
+            field.getTabletop().revalidate();
+        }
+    }
+
+    /** Player plate: avatar with life, name, zone counters, and any poison/energy style counters. */
+    public static class Plate extends JPanel {
+        private final VField field;
+        private final JLabel name = new JLabel("", SwingConstants.CENTER);
+        private final JLabel extras = new JLabel("", SwingConstants.CENTER);
+
+        Plate(final VField field, final Avatar avatar, final PlayerDetailsPanel details) {
+            this.field = field;
+            setOpaque(false);
+            setLayout(new MigLayout("insets 8 6 8 6, gap 0, wrap, hidemode 3", "[center, grow, fill]"));
+            name.setFont(FSkin.getBoldFont(12).getBaseFont());
+            name.setForeground(TEXT);
+            extras.setFont(FSkin.getBoldFont(11).getBaseFont());
+            extras.setForeground(new Color(255, 196, 120));
+            add(avatar, "w 76!, h 84!, alignx center");
+            add(name, "w 10:100%, gaptop 2");
+            add(details, "w 10:100%, gaptop 4");
+            add(extras, "w 10:100%, gaptop 3");
+            refresh();
+        }
+
+        void refresh() {
+            final PlayerView p = field.getPlayer();
+            if (p == null) {
+                return;
+            }
+            name.setText(p.getName());
+            name.setToolTipText(p.getName());
+            final StringBuilder sb = new StringBuilder();
+            appendCounter(sb, "Poison", p.getCounters(CounterEnumType.POISON));
+            appendCounter(sb, "Energy", p.getCounters(CounterEnumType.ENERGY));
+            appendCounter(sb, "Exp", p.getCounters(CounterEnumType.EXPERIENCE));
+            appendCounter(sb, "Rad", p.getCounters(CounterEnumType.RAD));
+            appendCounter(sb, "Tickets", p.getCounters(CounterEnumType.TICKET));
+            extras.setText(sb.length() == 0 ? "" : "<html><center>" + sb + "</center></html>");
+            extras.setVisible(sb.length() > 0);
+            revalidate();
+            repaint();
+        }
+
+        private static void appendCounter(final StringBuilder sb, final String label, final int value) {
+            if (value > 0) {
+                if (sb.length() > 0) {
+                    sb.append("<br>");
+                }
+                sb.append(label).append(' ').append(value);
+            }
+        }
+
+        @Override
+        protected void paintComponent(final Graphics g) {
+            final Graphics2D g2 = (Graphics2D) g.create();
+            g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
+            final int w = getWidth();
+            final int h = getHeight();
+            g2.setColor(new Color(0, 0, 0, 80));
+            g2.fillRoundRect(1, 3, w - 2, h - 3, 18, 18);
+            g2.setColor(new Color(15, 24, 42, 236));
+            g2.fillRoundRect(0, 0, w - 2, h - 3, 18, 18);
+            final Color ring = field.isMirror() ? RING_OPPONENT : RING_YOU;
+            g2.setColor(new Color(ring.getRed(), ring.getGreen(), ring.getBlue(), 150));
+            g2.drawRoundRect(0, 0, w - 3, h - 4, 18, 18);
+            g2.dispose();
+        }
+    }
+
+    /** Round avatar with a life badge; the field's controller attaches its click handling to it. */
+    public static class Avatar extends JPanel {
+        private final VField field;
+        private boolean hover;
+
+        Avatar(final VField field) {
+            this.field = field;
+            setOpaque(false);
+            setCursor(Cursor.getPredefinedCursor(Cursor.HAND_CURSOR));
+            setPreferredSize(new Dimension(76, 84));
+            addMouseListener(new MouseAdapter() {
+                @Override
+                public void mouseEntered(final MouseEvent e) {
+                    hover = true;
+                    repaint();
+                }
+
+                @Override
+                public void mouseExited(final MouseEvent e) {
+                    hover = false;
+                    repaint();
+                }
+            });
+        }
+
+        @Override
+        protected void paintComponent(final Graphics g) {
+            final Graphics2D g2 = (Graphics2D) g.create();
+            g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
+            g2.setRenderingHint(RenderingHints.KEY_INTERPOLATION, RenderingHints.VALUE_INTERPOLATION_BILINEAR);
+            g2.setRenderingHint(RenderingHints.KEY_TEXT_ANTIALIASING, RenderingHints.VALUE_TEXT_ANTIALIAS_ON);
+            final int w = getWidth();
+            final int h = getHeight();
+            final int d = Math.max(10, Math.min(w, h - 12) - 8);
+            final int x = (w - d) / 2;
+            final int y = 4;
+            final boolean highlighted = field.isPlayerHighlighted();
+            final Color ring = highlighted ? GOLD : field.isMirror() ? RING_OPPONENT : RING_YOU;
+
+            if (highlighted || hover) {
+                g2.setColor(new Color(ring.getRed(), ring.getGreen(), ring.getBlue(), highlighted ? 110 : 60));
+                g2.fillOval(x - 4, y - 4, d + 8, d + 8);
+            }
+            final Shape circle = new Ellipse2D.Double(x, y, d, d);
+            g2.setColor(new Color(24, 32, 50));
+            g2.fill(circle);
+            if (field.getAvatarImage() != null) {
+                final Shape oldClip = g2.getClip();
+                g2.clip(circle);
+                FSkin.drawImage(g2, field.getAvatarImage(), x, y, d, d);
+                g2.setClip(oldClip);
+            }
+            g2.setStroke(new BasicStroke(highlighted ? 3f : 2f));
+            g2.setColor(ring);
+            g2.draw(circle);
+
+            final PlayerView p = field.getPlayer();
+            if (p != null) {
+                final String life = String.valueOf(p.getLife());
+                g2.setFont(FSkin.getBoldFont(14).getBaseFont());
+                final FontMetrics fm = g2.getFontMetrics();
+                final int bw = Math.max(34, fm.stringWidth(life) + 16);
+                final int bh = 20;
+                final int bx = (w - bw) / 2;
+                final int by = y + d - bh / 2;
+                g2.setColor(new Color(10, 17, 32));
+                g2.fillRoundRect(bx, by, bw, bh, 10, 10);
+                g2.setStroke(new BasicStroke(1.5f));
+                g2.setColor(ring);
+                g2.drawRoundRect(bx, by, bw, bh, 10, 10);
+                g2.setColor(p.getLife() <= VField.LIFE_CRITICAL ? new Color(255, 96, 86) : Color.WHITE);
+                g2.drawString(life, bx + (bw - fm.stringWidth(life)) / 2, by + (bh - fm.getHeight()) / 2 + fm.getAscent());
+            }
+            g2.dispose();
+        }
+    }
+}
