@@ -0,0 +1,218 @@
+package forge.screens.match;
+
+import java.awt.BasicStroke;
+import java.awt.Color;
+import java.awt.Cursor;
+import java.awt.Dimension;
+import java.awt.FontMetrics;
+import java.awt.GradientPaint;
+import java.awt.Graphics;
+import java.awt.Graphics2D;
+import java.awt.RenderingHints;
+import java.awt.event.MouseAdapter;
+import java.awt.event.MouseEvent;
+import java.awt.geom.Path2D;
+import java.awt.geom.RoundRectangle2D;
+
+import javax.swing.JComponent;
+import javax.swing.JPanel;
+import javax.swing.SwingUtilities;
+
+import forge.gui.framework.DragCell;
+import forge.gui.framework.EDocID;
+import forge.toolbox.FSkin;
+import net.miginfocom.swing.MigLayout;
+
+/** Slim column on the left of the match screen: drawer toggles on top, the tool dock below. */
+@SuppressWarnings("serial")
+class ArenaRail extends JPanel {
+    static final int WIDTH = 52;
+
+    static final Color NAVY_TOP = new Color(12, 21, 40);
+    static final Color NAVY_BOTTOM = new Color(16, 28, 51);
+    static final Color LINE = new Color(43, 59, 90);
+    static final Color GOLD = new Color(217, 168, 67);
+    static final Color TEXT = new Color(233, 237, 245);
+    static final Color MUTED = new Color(142, 155, 182);
+
+    private final RailButton stackButton;
+    private final RailButton combatButton;
+    private final RailButton logButton;
+
+    ArenaRail(final ArenaFrame frame) {
+        setOpaque(true);
+        setLayout(new MigLayout("insets 10 0 4 0, gap 0, flowy, alignx center"));
+        setPreferredSize(new Dimension(WIDTH, 100));
+        setMinimumSize(new Dimension(WIDTH, 100));
+
+        stackButton = new RailButton(Glyph.STACK, "Stack", () -> frame.toggleDrawer(EDocID.REPORT_STACK));
+        combatButton = new RailButton(Glyph.COMBAT, "Combat", () -> frame.toggleDrawer(EDocID.REPORT_COMBAT));
+        logButton = new RailButton(Glyph.LOG, "Game log", () -> frame.toggleDrawer(EDocID.REPORT_LOG));
+
+        final String buttonConstraints = "w 36!, h 36!, alignx center, gapbottom 8";
+        add(stackButton, buttonConstraints);
+        add(combatButton, buttonConstraints);
+        add(logButton, buttonConstraints);
+        add(new Divider(), "w 28!, h 1!, alignx center, gaptop 2, gapbottom 2");
+
+        final DragCell dock = frame.getPrivateCell(EDocID.BUTTON_DOCK);
+        if (dock != null) {
+            dock.setOpaque(false);
+            dock.getBody().setOpaque(false);
+            add(dock, "w " + WIDTH + "!, growy, pushy");
+        }
+    }
+
+    void setStackCount(final int count) {
+        stackButton.setBadge(count);
+    }
+
+    void setOpenDoc(final EDocID openDoc) {
+        stackButton.setSelected(openDoc == EDocID.REPORT_STACK);
+        combatButton.setSelected(openDoc == EDocID.REPORT_COMBAT);
+        logButton.setSelected(openDoc == EDocID.REPORT_LOG);
+    }
+
+    @Override
+    protected void paintComponent(final Graphics g) {
+        final Graphics2D g2 = (Graphics2D) g.create();
+        g2.setPaint(new GradientPaint(0, 0, NAVY_TOP, getWidth(), 0, NAVY_BOTTOM));
+        g2.fillRect(0, 0, getWidth(), getHeight());
+        g2.setColor(LINE);
+        g2.fillRect(getWidth() - 1, 0, 1, getHeight());
+        g2.dispose();
+    }
+
+    private static final class Divider extends JComponent {
+        @Override
+        protected void paintComponent(final Graphics g) {
+            g.setColor(LINE);
+            g.fillRect(0, 0, getWidth(), 1);
+        }
+    }
+
+    enum Glyph { STACK, COMBAT, LOG, CLOSE }
+
+    /** Draws a 24x24 line icon scaled into the given square. */
+    static void drawGlyph(final Graphics2D g, final Glyph glyph, final int x, final int y, final int size, final Color color) {
+        final Graphics2D g2 = (Graphics2D) g.create();
+        g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
+        g2.translate(x, y);
+        g2.scale(size / 24.0, size / 24.0);
+        g2.setColor(color);
+        g2.setStroke(new BasicStroke(2f, BasicStroke.CAP_ROUND, BasicStroke.JOIN_ROUND));
+        final Path2D p = new Path2D.Double();
+        switch (glyph) {
+            case STACK -> {
+                p.moveTo(12, 3); p.lineTo(2, 8); p.lineTo(12, 13); p.lineTo(22, 8); p.closePath();
+                p.moveTo(2, 13); p.lineTo(12, 18); p.lineTo(22, 13);
+                p.moveTo(2, 17.5); p.lineTo(12, 22.5); p.lineTo(22, 17.5);
+            }
+            case COMBAT -> {
+                p.moveTo(4, 4); p.lineTo(20, 20);
+                p.moveTo(20, 4); p.lineTo(4, 20);
+                p.moveTo(3, 15); p.lineTo(9, 21);
+                p.moveTo(21, 15); p.lineTo(15, 21);
+            }
+            case LOG -> {
+                p.append(new RoundRectangle2D.Double(5, 3, 14, 18, 4, 4), false);
+                p.moveTo(8.5, 8); p.lineTo(15.5, 8);
+                p.moveTo(8.5, 12); p.lineTo(15.5, 12);
+                p.moveTo(8.5, 16); p.lineTo(13, 16);
+            }
+            case CLOSE -> {
+                p.moveTo(6, 6); p.lineTo(18, 18);
+                p.moveTo(18, 6); p.lineTo(6, 18);
+            }
+        }
+        g2.draw(p);
+        g2.dispose();
+    }
+
+    /** Square icon button with hover, selected and badge states. */
+    static final class RailButton extends JComponent {
+        private final Glyph glyph;
+        private final Runnable action;
+        private boolean hover;
+        private boolean selected;
+        private int badge;
+
+        RailButton(final Glyph glyph, final String tooltip, final Runnable action) {
+            this.glyph = glyph;
+            this.action = action;
+            setToolTipText(tooltip);
+            setCursor(Cursor.getPredefinedCursor(Cursor.HAND_CURSOR));
+            addMouseListener(new MouseAdapter() {
+                @Override
+                public void mouseEntered(final MouseEvent e) {
+                    hover = true;
+                    repaint();
+                }
+
+                @Override
+                public void mouseExited(final MouseEvent e) {
+                    hover = false;
+                    repaint();
+                }
+
+                @Override
+                public void mouseClicked(final MouseEvent e) {
+                    if (SwingUtilities.isLeftMouseButton(e)) {
+                        RailButton.this.action.run();
+                    }
+                }
+            });
+        }
+
+        void setSelected(final boolean b) {
+            if (selected != b) {
+                selected = b;
+                repaint();
+            }
+        }
+
+        void setBadge(final int n) {
+            if (badge != n) {
+                badge = n;
+                repaint();
+            }
+        }
+
+        @Override
+        protected void paintComponent(final Graphics g) {
+            final Graphics2D g2 = (Graphics2D) g.create();
+            g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
+            final int w = getWidth();
+            final int h = getHeight();
+            final int inset = 2;
+            final RoundRectangle2D box = new RoundRectangle2D.Double(inset, inset, w - 2 * inset - 1, h - 2 * inset - 1, 10, 10);
+            if (selected) {
+                g2.setColor(new Color(217, 168, 67, 34));
+                g2.fill(box);
+                g2.setColor(new Color(217, 168, 67, 150));
+                g2.draw(box);
+            } else if (hover) {
+                g2.setColor(new Color(255, 255, 255, 22));
+                g2.fill(box);
+            } else {
+                g2.setColor(new Color(255, 255, 255, 8));
+                g2.fill(box);
+            }
+            final int icon = Math.round(Math.min(w, h) * 0.55f);
+            drawGlyph(g2, glyph, (w - icon) / 2, (h - icon) / 2, icon, selected || hover ? GOLD : MUTED);
+
+            if (badge > 0) {
+                final String text = String.valueOf(badge);
+                g2.setFont(FSkin.getBoldFont(10).getBaseFont());
+                final FontMetrics fm = g2.getFontMetrics();
+                final int bw = Math.max(15, fm.stringWidth(text) + 8);
+                final int bx = w - bw;
+                g2.setColor(GOLD);
+                g2.fillRoundRect(bx, 0, bw, 15, 15, 15);
+                g2.setColor(new Color(26, 18, 6));
+                g2.drawString(text, bx + (bw - fm.stringWidth(text)) / 2, 11);
+            }
+            g2.dispose();
+        }
+    }
+}
