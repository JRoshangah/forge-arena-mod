+package forge.screens.match;
+
+import java.awt.BorderLayout;
+import java.awt.Component;
+import java.awt.event.MouseListener;
+import java.awt.event.MouseMotionListener;
+import java.io.File;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.util.EnumMap;
+import java.util.Map;
+
+import javax.swing.JPanel;
+
+import forge.game.player.PlayerView;
+import forge.gui.framework.DragCell;
+import forge.gui.framework.EDocID;
+import forge.gui.framework.FScreen;
+import forge.gui.framework.ICDoc;
+import forge.gui.framework.IVDoc;
+import forge.gui.framework.VEmptyDoc;
+import forge.localinstance.properties.FileLocation;
+import forge.localinstance.properties.ForgeConstants;
+import forge.localinstance.properties.ForgePreferences.FPref;
+import forge.model.FModel;
+import forge.toolbox.FPanel;
+import forge.view.FView;
+
+/**
+ * Board-first match screen: the battlefields take most of the window, the stack, combat,
+ * log and tool buttons move to a slim rail with a slide-out drawer, and player details sit
+ * on plates beside each board. Built on Forge's dock framework: the layout file only holds
+ * the fields, hand, card preview and prompt; the other docs live in private cells here.
+ */
+public final class ArenaFrame {
+    public static final FileLocation LAYOUT_FILE = new FileLocation(
+            ForgeConstants.RES_DIR + "defaults" + ForgeConstants.PATH_SEPARATOR,
+            ForgeConstants.USER_PREFS_DIR, "match_arena.xml");
+
+    // Fractions of the dock area left of the rail.
+    private static final String DEFAULT_LAYOUT = """
+            <?xml version="1.0"?>
+            <layout serial="">
+            \t<cell x="0.0" y="0.0" w="0.785" h="0.43" sel="FIELD_1">
+            \t\t<doc>FIELD_1</doc>
+            \t</cell>
+            \t<cell x="0.0" y="0.43" w="0.785" h="0.37" sel="FIELD_0">
+            \t\t<doc>FIELD_0</doc>
+            \t</cell>
+            \t<cell x="0.0" y="0.8" w="0.785" h="0.2" sel="HAND_0">
+            \t\t<doc>HAND_0</doc>
+            \t</cell>
+            \t<cell x="0.785" y="0.0" w="0.215" h="0.47" sel="CARD_PICTURE">
+            \t\t<doc>CARD_PICTURE</doc>
+            \t</cell>
+            \t<cell x="0.785" y="0.47" w="0.215" h="0.22" sel="CARD_DETAIL">
+            \t\t<doc>CARD_DETAIL</doc>
+            \t</cell>
+            \t<cell x="0.785" y="0.69" w="0.215" h="0.31" sel="REPORT_MESSAGE">
+            \t\t<doc>REPORT_MESSAGE</doc>
+            \t</cell>
+            </layout>
+            """;
+
+    static final EDocID[] DRAWER_DOCS = {
+            EDocID.REPORT_STACK, EDocID.REPORT_COMBAT, EDocID.REPORT_LOG, EDocID.REPORT_DEPENDENCIES };
+
+    /** True when the board-first layout is switched on and its default layout file is available. */
+    public static boolean isRequested() {
+        return FModel.getPreferences().getPrefBoolean(FPref.UI_ARENA_LAYOUT) && ensureDefaultLayout();
+    }
+
+    private static boolean ensureDefaultLayout() {
+        final File file = new File(LAYOUT_FILE.defaultLoc);
+        if (file.exists()) {
+            return true;
+        }
+        try {
+            Files.writeString(file.toPath(), DEFAULT_LAYOUT, StandardCharsets.UTF_8);
+            return true;
+        } catch (final IOException e) {
+            System.err.println("Board-first layout unavailable, could not write " + file + ": " + e.getMessage());
+            return false;
+        }
+    }
+
+    /** Called by SLayoutIO after it has built the cells for a screen. */
+    public static void afterLayoutLoaded(final FScreen screen) {
+        if (screen != null && screen.getController() instanceof CMatchUI matchUI && matchUI.isArenaMode()) {
+            matchUI.getArenaFrame().install();
+        }
+    }
+
+    private final CMatchUI matchUI;
+    private final Map<EDocID, DragCell> privateCells = new EnumMap<>(EDocID.class);
+    private final ArenaPhaseBar phaseBar;
+    private ArenaRail rail;
+    private ArenaDrawer drawer;
+
+    ArenaFrame(final CMatchUI matchUI) {
+        this.matchUI = matchUI;
+        this.phaseBar = new ArenaPhaseBar(matchUI);
+    }
+
+    CMatchUI getMatchUI() {
+        return matchUI;
+    }
+
+    public ArenaPhaseBar getPhaseBar() {
+        return phaseBar;
+    }
+
+    DragCell getPrivateCell(final EDocID id) {
+        return privateCells.get(id);
+    }
+
+    ArenaRail getRail() {
+        return rail;
+    }
+
+    private void install() {
+        if (rail == null) {
+            for (final EDocID id : DRAWER_DOCS) {
+                adopt(id);
+            }
+            adopt(EDocID.BUTTON_DOCK);
+            drawer = new ArenaDrawer(this);
+            rail = new ArenaRail(this);
+        }
+        final FView view = FView.SINGLETON_INSTANCE;
+        view.getPnlInsets().add(rail, BorderLayout.WEST);
+        for (final DragCell cell : view.getDragCells()) {
+            styleCell(cell);
+        }
+        drawer.attach();
+        stackChanged();
+    }
+
+    void uninstall() {
+        if (drawer != null) {
+            drawer.detach();
+        }
+        if (rail != null && rail.getParent() != null) {
+            final java.awt.Container parent = rail.getParent();
+            parent.remove(rail);
+            parent.revalidate();
+        }
+    }
+
+    /** Moves a doc out of the dock layout into a cell that only this frame shows. */
+    private void adopt(final EDocID id) {
+        final IVDoc<? extends ICDoc> doc = id.getDoc();
+        if (doc == null || doc instanceof VEmptyDoc) {
+            return;
+        }
+        final DragCell previous = doc.getParentCell();
+        if (previous != null) {
+            previous.removeDoc(doc);
+        }
+        final DragCell cell = new DragCell();
+        removeListeners(cell.getBorderRight());
+        removeListeners(cell.getBorderBottom());
+        cell.addDoc(doc);
+        cell.doCellLayout(false);
+        styleBody(cell);
+        privateCells.put(id, cell);
+    }
+
+    private static void removeListeners(final JPanel panel) {
+        for (final MouseListener l : panel.getMouseListeners()) {
+            panel.removeMouseListener(l);
+        }
+        for (final MouseMotionListener l : panel.getMouseMotionListeners()) {
+            panel.removeMouseMotionListener(l);
+        }
+    }
+
+    private static void styleCell(final DragCell cell) {
+        cell.doCellLayout(false);
+        styleBody(cell);
+    }
+
+    private static void styleBody(final DragCell cell) {
+        final Component body = cell.getBody();
+        if (body instanceof FPanel panel) {
+            panel.setBorderToggle(false);
+        }
+    }
+
+    void toggleDrawer(final EDocID id) {
+        if (drawer != null) {
+            drawer.toggle(id);
+        }
+    }
+
+    void drawerChanged(final EDocID openDoc) {
+        if (rail != null) {
+            rail.setOpenDoc(openDoc);
+        }
+    }
+
+    void stackChanged() {
+        if (rail != null && matchUI.getGameView() != null) {
+            rail.setStackCount(matchUI.getGameView().getStack().size());
+        }
+    }
+
+    void turnChanged(final PlayerView player) {
+        phaseBar.turnChanged(player);
+    }
+}
diff --git a/forge-gui-desktop/src/main/java/forge/screens/match/ArenaPhaseBar.java b/forge-gui-desktop/src/main/java/forge/screens/match/ArenaPhaseBar.java
new file mode 100644
index 0000000000..125062c47e
--- /dev/null
+++ b/forge-gui-desktop/src/main/java/forge/screens/match/ArenaPhaseBar.java
@@ -0,0 +1,163 @@
+package forge.screens.match;
+
+import java.awt.Color;
+import java.awt.Cursor;
+import java.awt.Graphics;
+import java.awt.Graphics2D;
+import java.awt.RenderingHints;
+import java.awt.event.MouseAdapter;
+import java.awt.event.MouseEvent;
+import java.util.ArrayList;
+import java.util.List;
+
+import javax.swing.JLabel;
+import javax.swing.JPanel;
+
+import forge.game.GameView;
+import forge.game.player.PlayerView;
+import forge.screens.match.views.VField;
+import forge.toolbox.FSkin;
+import forge.toolbox.special.PhaseIndicator;
+import net.miginfocom.swing.MigLayout;
+
+/**
+ * One horizontal phase bar along the top of your battlefield. It shows the phase stops of the
+ * player whose turn it is; the button on the right switches to another player's stops.
+ */
+@SuppressWarnings("serial")
+public class ArenaPhaseBar extends JPanel {
+    public static final int HEIGHT = 30;
+    private static final Color MINE = new Color(120, 175, 240);
+    private static final Color THEIRS = new Color(240, 125, 115);
+
+    private final CMatchUI matchUI;
+    private final JLabel turnLabel = new JLabel();
+    private final JPanel holder = new JPanel(new MigLayout("insets 0, gap 0", "", "[center]"));
+    private final JLabel ownerButton = new JLabel();
+    private PlayerView shown;
+
+    ArenaPhaseBar(final CMatchUI matchUI) {
+        this.matchUI = matchUI;
+        setOpaque(false);
+        setLayout(new MigLayout("insets 4 12 4 12, gap 12", "[][grow, center][]", "[center]"));
+        holder.setOpaque(false);
+
+        turnLabel.setFont(FSkin.getBoldFont(12).getBaseFont());
+        turnLabel.setForeground(MINE);
+        ownerButton.setFont(FSkin.getFont(11).getBaseFont());
+        ownerButton.setForeground(ArenaRail.MUTED);
+        ownerButton.setCursor(Cursor.getPredefinedCursor(Cursor.HAND_CURSOR));
+        ownerButton.setToolTipText("<html>Phase stops are kept separately for each player's turn.<br>"
+                + "Click to view and change another player's stops.</html>");
+        ownerButton.addMouseListener(new MouseAdapter() {
+            @Override
+            public void mouseClicked(final MouseEvent e) {
+                showNextPlayer();
+            }
+
+            @Override
+            public void mouseEntered(final MouseEvent e) {
+                ownerButton.setForeground(ArenaRail.GOLD);
+            }
+
+            @Override
+            public void mouseExited(final MouseEvent e) {
+                ownerButton.setForeground(ArenaRail.MUTED);
+            }
+        });
+
+        add(turnLabel);
+        add(holder, "alignx center");
+        add(ownerButton, "alignx right");
+    }
+
+    @Override
+    public void addNotify() {
+        super.addNotify();
+        if (shown == null) {
+            final GameView gv = matchUI.getGameView();
+            if (gv != null) {
+                final PlayerView turn = gv.getPlayerTurn();
+                if (turn != null) {
+                    turnChanged(turn);
+                } else if (!gv.getPlayers().isEmpty()) {
+                    showFor(firstLocalOrAny(gv));
+                }
+            }
+        }
+    }
+
+    void turnChanged(final PlayerView player) {
+        if (player == null) {
+            return;
+        }
+        final GameView gv = matchUI.getGameView();
+        final boolean mine = matchUI.isLocalPlayer(player);
+        final String owner = mine && matchUI.getLocalPlayerCount() == 1 ? "Your turn" : player.getName();
+        turnLabel.setText((gv == null ? "" : "Turn " + gv.getTurn() + "  ·  ") + owner);
+        turnLabel.setForeground(mine ? MINE : THEIRS);
+        showFor(player);
+    }
+
+    private void showFor(final PlayerView player) {
+        final VField field = fieldFor(player);
+        if (field == null) {
+            return;
+        }
+        final PhaseIndicator indicator = field.getPhaseIndicator();
+        indicator.setHorizontal();
+        if (indicator.getParent() != holder) {
+            holder.removeAll();
+            holder.add(indicator);
+        }
+        shown = player;
+        final boolean mine = matchUI.isLocalPlayer(player) && matchUI.getLocalPlayerCount() == 1;
+        ownerButton.setText("Stops: " + (mine ? "your turn" : player.getName() + "'s turn") + "  ·  switch");
+        revalidate();
+        repaint();
+    }
+
+    private void showNextPlayer() {
+        final GameView gv = matchUI.getGameView();
+        if (gv == null) {
+            return;
+        }
+        final List<PlayerView> players = new ArrayList<>();
+        for (final PlayerView p : gv.getPlayers()) {
+            players.add(p);
+        }
+        if (players.isEmpty()) {
+            return;
+        }
+        final int idx = shown == null ? -1 : players.indexOf(shown);
+        showFor(players.get((idx + 1) % players.size()));
+    }
+
+    private PlayerView firstLocalOrAny(final GameView gv) {
+        for (final PlayerView p : gv.getPlayers()) {
+            if (matchUI.isLocalPlayer(p)) {
+                return p;
+            }
+        }
+        return gv.getPlayers().iterator().next();
+    }
+
+    private VField fieldFor(final PlayerView player) {
+        try {
+            return matchUI.getFieldViewFor(player);
+        } catch (final IndexOutOfBoundsException e) {
+            return null;
+        }
+    }
+
+    @Override
+    protected void paintComponent(final Graphics g) {
+        final Graphics2D g2 = (Graphics2D) g.create();
+        g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
+        g2.setColor(new Color(10, 17, 32, 200));
+        g2.fillRoundRect(2, 2, getWidth() - 4, getHeight() - 4, 12, 12);
+        g2.setColor(new Color(43, 59, 90));
+        g2.drawRoundRect(2, 2, getWidth() - 5, getHeight() - 5, 12, 12);
+        g2.dispose();
+    }
+}
