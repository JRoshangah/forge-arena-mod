+package forge.screens.match;
+
+import java.awt.BasicStroke;
+import java.awt.BorderLayout;
+import java.awt.CardLayout;
+import java.awt.Color;
+import java.awt.Cursor;
+import java.awt.FontMetrics;
+import java.awt.Graphics;
+import java.awt.Graphics2D;
+import java.awt.Rectangle;
+import java.awt.RenderingHints;
+import java.awt.event.ComponentAdapter;
+import java.awt.event.ComponentEvent;
+import java.awt.event.ComponentListener;
+import java.awt.event.MouseAdapter;
+import java.awt.event.MouseEvent;
+import java.util.EnumMap;
+import java.util.Map;
+
+import javax.swing.BorderFactory;
+import javax.swing.JComponent;
+import javax.swing.JLayeredPane;
+import javax.swing.JPanel;
+import javax.swing.SwingUtilities;
+
+import forge.Singletons;
+import forge.gui.framework.DragCell;
+import forge.gui.framework.EDocID;
+import forge.toolbox.FSkin;
+import net.miginfocom.swing.MigLayout;
+
+/** Panel that slides out beside the rail and shows the stack, combat, log or card links. */
+@SuppressWarnings("serial")
+class ArenaDrawer extends JPanel {
+    private static final int WIDTH = 330;
+    private static final Integer LAYER = JLayeredPane.PALETTE_LAYER + 1;
+    private static final Color BG = new Color(15, 24, 42, 246);
+
+    private final ArenaFrame frame;
+    private final CardLayout cards = new CardLayout();
+    private final JPanel body = new JPanel(cards);
+    private final Map<EDocID, TabPill> tabs = new EnumMap<>(EDocID.class);
+    private final ComponentListener follower = new ComponentAdapter() {
+        @Override
+        public void componentResized(final ComponentEvent e) {
+            position();
+        }
+
+        @Override
+        public void componentMoved(final ComponentEvent e) {
+            position();
+        }
+    };
+    private EDocID open;
+    private boolean attached;
+
+    ArenaDrawer(final ArenaFrame frame) {
+        this.frame = frame;
+        setOpaque(false);
+        setLayout(new BorderLayout());
+        setBorder(BorderFactory.createEmptyBorder(8, 8, 10, 10));
+        // swallow clicks on the drawer's own background so they don't reach the board underneath
+        addMouseListener(new MouseAdapter() { });
+
+        final JPanel header = new JPanel(new MigLayout("insets 0 2 6 0, gap 4", "", "[center]"));
+        header.setOpaque(false);
+        final String[] titles = {"Stack", "Combat", "Log", "Card Links"};
+        for (int i = 0; i < ArenaFrame.DRAWER_DOCS.length; i++) {
+            final EDocID id = ArenaFrame.DRAWER_DOCS[i];
+            final DragCell cell = frame.getPrivateCell(id);
+            if (cell == null) {
+                continue;
+            }
+            final TabPill pill = new TabPill(titles[i], () -> show(id));
+            tabs.put(id, pill);
+            header.add(pill, "h 24!");
+            body.add(cell, id.name());
+        }
+        final CloseButton close = new CloseButton(this::hideDrawer);
+        header.add(close, "pushx, alignx right, w 24!, h 24!");
+
+        body.setOpaque(false);
+        add(header, BorderLayout.NORTH);
+        add(body, BorderLayout.CENTER);
+        setVisible(false);
+    }
+
+    void attach() {
+        if (attached) {
+            return;
+        }
+        final JLayeredPane lpn = Singletons.getView().getLpnDocument();
+        lpn.add(this, LAYER);
+        lpn.addComponentListener(follower);
+        final ArenaRail rail = frame.getRail();
+        if (rail != null) {
+            rail.addComponentListener(follower);
+        }
+        attached = true;
+        position();
+    }
+
+    void detach() {
+        if (!attached) {
+            return;
+        }
+        hideDrawer();
+        final JLayeredPane lpn = Singletons.getView().getLpnDocument();
+        lpn.removeComponentListener(follower);
+        final ArenaRail rail = frame.getRail();
+        if (rail != null) {
+            rail.removeComponentListener(follower);
+        }
+        lpn.remove(this);
+        lpn.repaint();
+        attached = false;
+    }
+
+    void toggle(final EDocID id) {
+        if (isVisible() && open == id) {
+            hideDrawer();
+        } else {
+            show(id);
+        }
+    }
+
+    private void show(final EDocID id) {
+        if (!tabs.containsKey(id)) {
+            return;
+        }
+        open = id;
+        cards.show(body, id.name());
+        for (final Map.Entry<EDocID, TabPill> e : tabs.entrySet()) {
+            e.getValue().setSelected(e.getKey() == id);
+        }
+        position();
+        setVisible(true);
+        revalidate();
+        repaint();
+        frame.drawerChanged(id);
+    }
+
+    void hideDrawer() {
+        if (!isVisible()) {
+            return;
+        }
+        setVisible(false);
+        open = null;
+        final java.awt.Container parent = getParent();
+        if (parent != null) {
+            parent.repaint(getX(), getY(), getWidth(), getHeight());
+        }
+        frame.drawerChanged(null);
+    }
+
+    private void position() {
+        final ArenaRail rail = frame.getRail();
+        if (!attached || rail == null) {
+            return;
+        }
+        if (!rail.isShowing()) {
+            hideDrawer();
+            return;
+        }
+        final JLayeredPane lpn = Singletons.getView().getLpnDocument();
+        final Rectangle r = SwingUtilities.convertRectangle(rail.getParent(), rail.getBounds(), lpn);
+        setBounds(r.x + r.width, r.y, WIDTH, r.height);
+        revalidate();
+    }
+
+    @Override
+    protected void paintComponent(final Graphics g) {
+        final Graphics2D g2 = (Graphics2D) g.create();
+        g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
+        final int w = getWidth();
+        final int h = getHeight();
+        g2.setColor(new Color(0, 0, 0, 90));
+        g2.fillRoundRect(0, 0, w, h, 16, 16);
+        g2.setColor(BG);
+        g2.fillRoundRect(0, 0, w - 4, h - 4, 14, 14);
+        g2.fillRect(0, 0, 14, h - 4);
+        g2.setColor(new Color(217, 168, 67, 120));
+        g2.setStroke(new BasicStroke(1f));
+        g2.drawRoundRect(0, 0, w - 5, h - 5, 14, 14);
+        g2.dispose();
+    }
+
+    /** Header tab in the drawer. */
+    private static final class TabPill extends JComponent {
+        private final String text;
+        private boolean selected;
+        private boolean hover;
+
+        TabPill(final String text, final Runnable action) {
+            this.text = text;
+            setFont(FSkin.getBoldFont(12).getBaseFont());
+            setCursor(Cursor.getPredefinedCursor(Cursor.HAND_CURSOR));
+            addMouseListener(new MouseAdapter() {
+                @Override
+                public void mouseClicked(final MouseEvent e) {
+                    action.run();
+                }
+
+                @Override
+                public void mouseEntered(final MouseEvent e) {
+                    hover = true;
+                    repaint();
+                }
+
+                @Override
+                public void mouseExited(final MouseEvent e) {
+                    hover = false;
+                    repaint();
+                }
+            });
+        }
+
+        void setSelected(final boolean b) {
+            selected = b;
+            repaint();
+        }
+
+        @Override
+        public java.awt.Dimension getPreferredSize() {
+            final FontMetrics fm = getFontMetrics(getFont());
+            return new java.awt.Dimension(fm.stringWidth(text) + 20, 24);
+        }
+
+        @Override
+        protected void paintComponent(final Graphics g) {
+            final Graphics2D g2 = (Graphics2D) g.create();
+            g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
+            g2.setRenderingHint(RenderingHints.KEY_TEXT_ANTIALIASING, RenderingHints.VALUE_TEXT_ANTIALIAS_ON);
+            final int w = getWidth();
+            final int h = getHeight();
+            if (selected) {
+                g2.setColor(ArenaRail.GOLD);
+                g2.fillRoundRect(0, 0, w, h, h, h);
+            } else if (hover) {
+                g2.setColor(new Color(255, 255, 255, 26));
+                g2.fillRoundRect(0, 0, w, h, h, h);
+            }
+            g2.setFont(getFont());
+            final FontMetrics fm = g2.getFontMetrics();
+            g2.setColor(selected ? new Color(26, 18, 6) : ArenaRail.TEXT);
+            g2.drawString(text, (w - fm.stringWidth(text)) / 2, (h - fm.getHeight()) / 2 + fm.getAscent());
+            g2.dispose();
+        }
+    }
+
+    private static final class CloseButton extends JComponent {
+        private boolean hover;
+
+        CloseButton(final Runnable action) {
+            setToolTipText("Close");
+            setCursor(Cursor.getPredefinedCursor(Cursor.HAND_CURSOR));
+            addMouseListener(new MouseAdapter() {
+                @Override
+                public void mouseClicked(final MouseEvent e) {
+                    action.run();
+                }
+
+                @Override
+                public void mouseEntered(final MouseEvent e) {
+                    hover = true;
+                    repaint();
+                }
+
+                @Override
+                public void mouseExited(final MouseEvent e) {
+                    hover = false;
+                    repaint();
+                }
+            });
+        }
+
+        @Override
+        protected void paintComponent(final Graphics g) {
+            final int s = Math.min(getWidth(), getHeight());
+            ArenaRail.drawGlyph((Graphics2D) g, ArenaRail.Glyph.CLOSE, (getWidth() - s) / 2 + 4, (getHeight() - s) / 2 + 4,
+                    s - 8, hover ? ArenaRail.GOLD : ArenaRail.MUTED);
+        }
+    }
+}
