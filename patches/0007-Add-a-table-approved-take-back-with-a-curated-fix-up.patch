diff --git a/forge-gui/src/main/java/forge/player/TakeBackTools.java b/forge-gui/src/main/java/forge/player/TakeBackTools.java
new file mode 100644
index 0000000000..5dceb714b0
--- /dev/null
+++ b/forge-gui/src/main/java/forge/player/TakeBackTools.java
@@ -0,0 +1,106 @@
+package forge.player;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+
+import forge.game.Game;
+import forge.game.GameEntityView;
+import forge.game.GameEntityViewMap;
+import forge.game.ability.AbilityKey;
+import forge.game.card.Card;
+import forge.game.card.CardView;
+import forge.game.player.Player;
+import forge.game.player.PlayerView;
+import forge.game.zone.ZoneType;
+import forge.gamemodes.match.TakeBackMessage;
+import forge.gui.interfaces.IGuiGame;
+
+/**
+ * The curated fix-up tools a player may run while the table has granted them a take-back.
+ *
+ * <p>Most of them are the matching Dev Mode action, which already prompts through the player's
+ * own GUI and therefore works for a network client too (the host runs their controller). The
+ * one addition is {@link #moveCard}, because putting an existing card back where it belongs is
+ * what a take-back is usually about, and Dev Mode can only conjure new copies.</p>
+ */
+public final class TakeBackTools {
+    private TakeBackTools() {}
+
+    private static final List<ZoneType> ZONES = Arrays.asList(
+            ZoneType.Battlefield, ZoneType.Hand, ZoneType.Graveyard, ZoneType.Exile,
+            ZoneType.Library, ZoneType.Command);
+
+    /** Runs one tool for {@code pch}. The caller must have checked the grant first. */
+    public static void run(final PlayerControllerHuman pch, final TakeBackMessage.Tool tool) {
+        switch (tool) {
+            case UNTAP -> pch.cheat().untapPermanents();
+            case TAP -> pch.cheat().tapPermanents();
+            case SET_LIFE -> pch.cheat().setPlayerLife();
+            case ADD_COUNTERS -> pch.cheat().addCountersToPermanent();
+            case REMOVE_COUNTERS -> pch.cheat().removeCountersFromPermanent();
+            case MANA -> pch.cheat().generateMana();
+            case MOVE_CARD -> moveCard(pch);
+        }
+    }
+
+    /** Asks for a card and a destination zone, then moves that card there. */
+    private static void moveCard(final PlayerControllerHuman pch) {
+        final IGuiGame gui = pch.getGui();
+        final Game game = pch.getGame();
+
+        final GameEntityViewMap<Player, PlayerView> players = GameEntityView.getMap(game.getPlayers());
+        final PlayerView pv = gui.oneOrNone("Move a card belonging to which player?", players.getTrackableKeys());
+        if (pv == null || !players.containsKey(pv)) {
+            return;
+        }
+        final Player owner = players.get(pv);
+
+        final ZoneType from = gui.oneOrNone("Move the card out of which zone?", new ArrayList<>(ZONES));
+        if (from == null) {
+            return;
+        }
+        final GameEntityViewMap<Card, CardView> cards = GameEntityView.getMap(owner.getCardsIn(from));
+        if (cards.isEmpty()) {
+            gui.message("No cards there.", "Take-back");
+            return;
+        }
+        final CardView cv = gui.oneOrNone("Move which card?", cards.getTrackableKeys());
+        if (cv == null || !cards.containsKey(cv)) {
+            return;
+        }
+        final Card card = cards.get(cv);
+
+        final List<ZoneType> destinations = new ArrayList<>(ZONES);
+        destinations.remove(from);
+        final ZoneType to = gui.oneOrNone("Move " + card.getName() + " to which zone?", destinations);
+        if (to == null) {
+            return;
+        }
+
+        if (to == ZoneType.Battlefield && !card.isPermanent()) {
+            gui.message(card.getName() + " can't sit on the battlefield.", "Take-back");
+            return;
+        }
+        final boolean toLibraryTop = to != ZoneType.Library
+                || gui.confirm(cv, "Put " + card.getName() + " on top of the library?", true,
+                        Arrays.asList("Top", "Bottom"));
+        final boolean sick = to == ZoneType.Battlefield && card.isCreature()
+                && gui.confirm(cv, "Should " + card.getName() + " have summoning sickness?");
+
+        game.getAction().invoke(() -> {
+            final Card moved;
+            if (to == ZoneType.Library && !toLibraryTop) {
+                moved = game.getAction().moveToBottomOfLibrary(card, null);
+            } else if (to == ZoneType.Library) {
+                moved = game.getAction().moveToLibrary(card, null);
+            } else {
+                moved = game.getAction().moveTo(to, card, null, AbilityKey.newMap());
+            }
+            if (moved != null && to == ZoneType.Battlefield && moved.isCreature()) {
+                moved.setSickness(sick);
+            }
+            game.getTriggerHandler().runWaitingTriggers();
+        });
+    }
+}
