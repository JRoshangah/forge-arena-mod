diff --git a/forge-gui-desktop/src/main/java/forge/screens/match/views/VTakeBackDialog.java b/forge-gui-desktop/src/main/java/forge/screens/match/views/VTakeBackDialog.java
new file mode 100644
index 0000000000..0f22a49036
--- /dev/null
+++ b/forge-gui-desktop/src/main/java/forge/screens/match/views/VTakeBackDialog.java
@@ -0,0 +1,265 @@
+package forge.screens.match.views;
+
+import javax.swing.SwingConstants;
+import javax.swing.Timer;
+
+import forge.game.player.PlayerView;
+import forge.gamemodes.match.TakeBackMessage;
+import forge.gui.UiCommand;
+import forge.screens.match.CMatchUI;
+import forge.toolbox.FButton;
+import forge.toolbox.FLabel;
+import forge.view.FDialog;
+
+/**
+ * Non-modal dialog for the take-back flow. One instance is kept by {@link CMatchUI} and
+ * {@link #refresh} is called on every broadcast, so it turns from a vote prompt into the
+ * fix-up tool box (for the player who was granted the window) or a read-only notice (for
+ * everyone else) without ever stealing the board.
+ */
+@SuppressWarnings("serial")
+public class VTakeBackDialog extends FDialog {
+    private static final int PADDING = 12;
+    private static final int WIDTH = 380;
+    private static final int ROW_HEIGHT = 22;
+    private static final int BUTTON_WIDTH = 120;
+    private static final int BUTTON_HEIGHT = 28;
+    private static final int TOOL_HEIGHT = 30;
+    private static final int TOOL_GAP = 6;
+
+    private final CMatchUI matchUI;
+    /** The local player this dialog is acting for: the voter, or the holder of the window. */
+    private PlayerView localPlayer;
+    /** True while the local player holds a live window, so closing the dialog hands it back. */
+    private boolean holdsWindow;
+    private boolean closingInternally;
+
+    /** Bumped on every broadcast, so an action can tell whether new state arrived while it ran. */
+    private int refreshes;
+
+    private final Timer clock;
+    private FLabel clockLabel;
+    private long deadlineMs;
+
+    public VTakeBackDialog(final CMatchUI matchUI) {
+        super(false, false, "0");
+        this.matchUI = matchUI;
+        setTitle("Take-back");
+        clock = new Timer(1000, e -> tick());
+        clock.setRepeats(true);
+    }
+
+    /** Rebuild the dialog for {@code update} as seen by {@code local} (null for a bystander). */
+    public void refresh(final TakeBackMessage.Status update, final PlayerView local) {
+        this.localPlayer = local;
+        refreshes++;
+        getContentPane().removeAll();
+        clockLabel = null;
+
+        final int w = WIDTH - 2 * PADDING;
+        int y = PADDING;
+
+        if (update.isOver()) {
+            holdsWindow = false;
+            clock.stop();
+            y = addWrapped(resultText(update), y, w, 2);
+            y += 6;
+            y = addCentered(new String[] { "Close" }, new Runnable[] { this::dispose }, y);
+            finishLayout(y + PADDING);
+            return;
+        }
+
+        startClock(update.secondsLeft());
+
+        if (update.phase() == TakeBackMessage.Phase.GRANTED) {
+            holdsWindow = local != null && update.isRequester(local);
+            y = holdsWindow ? layoutTools(update, y, w) : layoutWatching(update, y, w);
+        } else {
+            holdsWindow = false;
+            y = layoutVoting(update, local, y, w);
+        }
+        finishLayout(y + PADDING);
+    }
+
+    /** The fix-up tool box, shown only to the player the table agreed to help. */
+    private int layoutTools(final TakeBackMessage.Status update, int y, final int w) {
+        y = addWrapped("The table agreed. Fix the board, then press Done.", y, w, 1);
+        y = addClock(y, w);
+        y += 4;
+
+        final TakeBackMessage.Tool[] tools = TakeBackMessage.Tool.values();
+        final int toolWidth = (w - TOOL_GAP) / 2;
+        for (int i = 0; i < tools.length; i++) {
+            final TakeBackMessage.Tool tool = tools[i];
+            final FButton button = new FButton(tool.getLabel());
+            button.setToolTipText(tool.getHint());
+            button.setCommand((UiCommand) () -> runTool(tool));
+            final int x = PADDING + (i % 2) * (toolWidth + TOOL_GAP);
+            add(button, x, y + (i / 2) * (TOOL_HEIGHT + TOOL_GAP), toolWidth, TOOL_HEIGHT);
+        }
+        y += ((tools.length + 1) / 2) * (TOOL_HEIGHT + TOOL_GAP) + 4;
+
+        return addCentered(new String[] { "Done" }, new Runnable[] { this::finish }, y);
+    }
+
+    /** What everyone else sees while the board is being fixed. */
+    private int layoutWatching(final TakeBackMessage.Status update, int y, final int w) {
+        y = addWrapped(update.requester().getName() + " is fixing the board. Cards and life may move.", y, w, 2);
+        y = addClock(y, w);
+        y += 4;
+        return addCentered(new String[] { "Hide" }, new Runnable[] { () -> setVisible(false) }, y);
+    }
+
+    private int layoutVoting(final TakeBackMessage.Status update, final PlayerView local, int y, final int w) {
+        final boolean mine = update.isRequester(local);
+        y = addWrapped(mine
+                ? "Waiting for the table to allow your take-back."
+                : update.requester().getName() + " asks to take back a play. Everyone has to agree.", y, w, 2);
+        for (final TakeBackMessage.Entry entry : update.entries()) {
+            final FLabel row = new FLabel.Builder()
+                    .text(entry.player().getName() + ": " + voteText(entry.vote()))
+                    .fontSize(12).fontAlign(SwingConstants.LEFT).build();
+            add(row, PADDING, y, w, ROW_HEIGHT);
+            y += ROW_HEIGHT;
+        }
+        y = addClock(y, w);
+        y += 6;
+
+        if (!mine && local != null && update.isPending(local)) {
+            return addCentered(new String[] { "Allow", "Refuse" },
+                    new Runnable[] { () -> vote(true), () -> vote(false) }, y);
+        }
+        if (mine) {
+            return addCentered(new String[] { "Cancel" }, new Runnable[] { this::finish }, y);
+        }
+        return addCentered(new String[] { "Hide" }, new Runnable[] { () -> setVisible(false) }, y);
+    }
+
+    private String resultText(final TakeBackMessage.Status update) {
+        final String who = update.requester().getName();
+        return switch (update.phase()) {
+            case DECLINED -> "The take-back was refused.";
+            case TIMED_OUT -> "Nobody answered " + who + "'s take-back request.";
+            case FINISHED -> who + " finished the take-back.";
+            case EXPIRED -> "The take-back window ran out.";
+            default -> "The take-back is over.";
+        };
+    }
+
+    private String voteText(final TakeBackMessage.Vote vote) {
+        return switch (vote) {
+            case ACCEPTED -> "allowed";
+            case DECLINED -> "refused";
+            case PENDING -> "deciding…";
+        };
+    }
+
+    private int addWrapped(final String text, int y, final int w, final int lines) {
+        final FLabel label = new FLabel.Builder()
+                .text("<html>" + text + "</html>")
+                .fontAlign(SwingConstants.LEFT).build();
+        add(label, PADDING, y, w, ROW_HEIGHT * lines);
+        return y + ROW_HEIGHT * lines + 4;
+    }
+
+    private int addClock(int y, final int w) {
+        clockLabel = new FLabel.Builder().text(clockText()).fontSize(12).fontAlign(SwingConstants.LEFT).build();
+        add(clockLabel, PADDING, y, w, ROW_HEIGHT);
+        return y + ROW_HEIGHT;
+    }
+
+    private int addCentered(final String[] labels, final Runnable[] actions, final int y) {
+        final int total = labels.length * BUTTON_WIDTH + (labels.length - 1) * PADDING;
+        int x = (WIDTH - total) / 2;
+        for (int i = 0; i < labels.length; i++) {
+            final Runnable action = actions[i];
+            final FButton button = new FButton(labels[i]);
+            button.setCommand((UiCommand) action::run);
+            add(button, x, y, BUTTON_WIDTH, BUTTON_HEIGHT);
+            x += BUTTON_WIDTH + PADDING;
+        }
+        return y + BUTTON_HEIGHT;
+    }
+
+    private void startClock(final int secondsLeft) {
+        deadlineMs = System.currentTimeMillis() + secondsLeft * 1000L;
+        if (!clock.isRunning()) {
+            clock.start();
+        }
+    }
+
+    private void tick() {
+        if (clockLabel != null) {
+            clockLabel.setText(clockText());
+        }
+    }
+
+    private String clockText() {
+        final long left = Math.max(0, deadlineMs - System.currentTimeMillis());
+        final long seconds = (left + 999) / 1000;
+        return String.format("%d:%02d left", seconds / 60, seconds % 60);
+    }
+
+    private void finishLayout(final int height) {
+        getContentPane().revalidate();
+        getContentPane().repaint();
+        pack(); // realize the title bar so its height is known before we size the frame
+        setSize(WIDTH, height + getTitleBar().getHeight() + PADDING);
+        if (!isVisible()) {
+            setLocationRelativeTo(null); // the resize above drops it in a corner otherwise
+            setVisible(true);
+        }
+    }
+
+    private void runTool(final TakeBackMessage.Tool tool) {
+        if (localPlayer != null) {
+            matchUI.getGameController(localPlayer).takeBackTool(tool);
+        }
+    }
+
+    private void vote(final boolean accept) {
+        final int before = refreshes;
+        if (localPlayer != null) {
+            matchUI.getGameController(localPlayer).takeBackAction(
+                    accept ? TakeBackMessage.Action.ACCEPT : TakeBackMessage.Action.DECLINE);
+        }
+        if (refreshes == before) {
+            // Nothing new arrived, so this was the tally: put it away. If the vote settled the
+            // request the broadcast has already rebuilt this dialog, and hiding it would take
+            // the fix-up tools (or the outcome) away again.
+            closeQuietly();
+        }
+    }
+
+    private void finish() {
+        holdsWindow = false;
+        if (localPlayer != null) {
+            matchUI.getGameController(localPlayer).takeBackAction(TakeBackMessage.Action.FINISH);
+        }
+        closingInternally = true;
+        dispose();
+        closingInternally = false;
+    }
+
+    private void closeQuietly() {
+        closingInternally = true;
+        setVisible(false);
+        closingInternally = false;
+    }
+
+    /** Closing the tool box from the title bar hands the window back instead of leaving it open. */
+    @Override
+    public void setVisible(final boolean visible) {
+        if (!visible && holdsWindow && !closingInternally) {
+            finish();
+            return;
+        }
+        super.setVisible(visible);
+    }
+
+    @Override
+    public void dispose() {
+        clock.stop();
+        super.dispose();
+    }
+}
diff --git a/forge-gui/src/main/java/forge/gamemodes/match/TakeBackCoordinator.java b/forge-gui/src/main/java/forge/gamemodes/match/TakeBackCoordinator.java
new file mode 100644
index 0000000000..69f121f8d0
--- /dev/null
+++ b/forge-gui/src/main/java/forge/gamemodes/match/TakeBackCoordinator.java
@@ -0,0 +1,227 @@
+package forge.gamemodes.match;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.WeakHashMap;
+import java.util.concurrent.Executors;
+import java.util.concurrent.ScheduledExecutorService;
+import java.util.concurrent.ScheduledFuture;
+import java.util.concurrent.TimeUnit;
+
+import forge.game.Game;
+import forge.game.GameLogEntryType;
+import forge.game.player.Player;
+import forge.gui.interfaces.IGuiGame;
+import forge.player.PlayerControllerHuman;
+
+/**
+ * Orchestrates a take-back: one player asks the table to fix the board, every other human has
+ * to say yes, and the requester then gets a short window in which the curated fix-up tools are
+ * unlocked for them. Nothing is rewound by the engine — the players correct the board by hand —
+ * so the only thing guarded here is who may touch those tools, and for how long.
+ *
+ * <p>All state lives on the host: a network client can only ask, vote, and run a tool, and the
+ * host checks {@link #isGranted} before it lets any tool through.</p>
+ */
+public final class TakeBackCoordinator {
+    /** How long the table has to answer a request. */
+    public static final int VOTE_SECONDS = 60;
+    /** How long the requester may use the fix-up tools once the table agrees. */
+    public static final int GRANT_SECONDS = 120;
+
+    private TakeBackCoordinator() {}
+
+    private static final Map<Game, Session> SESSIONS = new WeakHashMap<>();
+
+    private static final ScheduledExecutorService TIMER = Executors.newSingleThreadScheduledExecutor(r -> {
+        final Thread t = new Thread(r, "take-back-timer");
+        t.setDaemon(true);
+        return t;
+    });
+
+    private static final class Session {
+        private final Player requester;
+        private final Map<Player, TakeBackMessage.Vote> votes = new LinkedHashMap<>();
+        private TakeBackMessage.Phase phase = TakeBackMessage.Phase.VOTING;
+        private long deadlineMs;
+        private ScheduledFuture<?> alarm;
+
+        Session(final Player requester) {
+            this.requester = requester;
+        }
+
+        boolean isExpired() {
+            return System.currentTimeMillis() >= deadlineMs;
+        }
+
+        int secondsLeft() {
+            return (int) Math.max(0, (deadlineMs - System.currentTimeMillis() + 999) / 1000);
+        }
+
+        void setClock(final int seconds, final Runnable onTimeout) {
+            cancelAlarm();
+            deadlineMs = System.currentTimeMillis() + seconds * 1000L;
+            alarm = TIMER.schedule(onTimeout, seconds, TimeUnit.SECONDS);
+        }
+
+        void cancelAlarm() {
+            if (alarm != null) {
+                alarm.cancel(false);
+                alarm = null;
+            }
+        }
+    }
+
+    /** Called when a player activates Request Take-Back. Ignored if one is already in flight. */
+    public static synchronized void request(final Game game, final Player requester) {
+        if (game == null || requester == null || game.isGameOver()) {
+            return;
+        }
+        final Session existing = SESSIONS.get(game);
+        if (existing != null) {
+            if (!existing.isExpired()) {
+                return; // one at a time
+            }
+            // Its clock ran out without anyone noticing: close it before opening a new one.
+            end(game, existing, existing.phase == TakeBackMessage.Phase.GRANTED
+                    ? TakeBackMessage.Phase.EXPIRED : TakeBackMessage.Phase.TIMED_OUT, "The take-back window closed.");
+        }
+        final Session session = new Session(requester);
+        for (final Player p : game.getPlayers()) {
+            if (p != requester && p.getController() instanceof PlayerControllerHuman) {
+                session.votes.put(p, TakeBackMessage.Vote.PENDING);
+            }
+        }
+        SESSIONS.put(game, session);
+        log(game, requester.getName() + " asked for a take-back.");
+
+        if (session.votes.isEmpty()) {
+            grant(game, session); // only AI opponents left: nobody to ask
+            return;
+        }
+        session.setClock(VOTE_SECONDS, () -> timeOut(game, session));
+        broadcast(game, session);
+    }
+
+    /** Called when a human opponent answers. */
+    public static synchronized void respond(final Game game, final Player responder, final boolean accept) {
+        final Session session = SESSIONS.get(game);
+        if (session == null || session.phase != TakeBackMessage.Phase.VOTING
+                || !session.votes.containsKey(responder)) {
+            return; // stale
+        }
+        session.votes.put(responder, accept ? TakeBackMessage.Vote.ACCEPTED : TakeBackMessage.Vote.DECLINED);
+        if (!accept) {
+            end(game, session, TakeBackMessage.Phase.DECLINED, responder.getName() + " turned the take-back down.");
+            return;
+        }
+        // Somebody who has left the game can no longer answer, so don't wait for them.
+        session.votes.keySet().removeIf(p -> !game.getPlayers().contains(p));
+        if (session.votes.values().stream().allMatch(v -> v == TakeBackMessage.Vote.ACCEPTED)) {
+            grant(game, session);
+            return;
+        }
+        broadcast(game, session);
+    }
+
+    /** Called when the requester presses Done, or cancels a request nobody has answered yet. */
+    public static synchronized void finish(final Game game, final Player player) {
+        final Session session = SESSIONS.get(game);
+        if (session == null || session.requester != player) {
+            return;
+        }
+        end(game, session, TakeBackMessage.Phase.FINISHED, session.phase == TakeBackMessage.Phase.VOTING
+                ? player.getName() + " withdrew the take-back request."
+                : player.getName() + " finished the take-back.");
+    }
+
+    /**
+     * The gate every fix-up tool goes through on the host: true only while this player's own
+     * window is open. Also closes a window that ran out while nobody was looking.
+     */
+    public static synchronized boolean isGranted(final Game game, final Player player) {
+        final Session session = SESSIONS.get(game);
+        if (session == null || session.phase != TakeBackMessage.Phase.GRANTED || session.requester != player) {
+            return false;
+        }
+        if (session.isExpired()) {
+            expire(game, session);
+            return false;
+        }
+        return true;
+    }
+
+    /** True while any take-back is in flight, so a second request can be refused politely. */
+    public static synchronized boolean isBusy(final Game game) {
+        final Session session = SESSIONS.get(game);
+        return session != null && !session.isExpired()
+                && (session.phase == TakeBackMessage.Phase.VOTING || session.phase == TakeBackMessage.Phase.GRANTED);
+    }
+
+    private static void grant(final Game game, final Session session) {
+        session.phase = TakeBackMessage.Phase.GRANTED;
+        session.setClock(GRANT_SECONDS, () -> expireLater(game, session));
+        log(game, "Take-back granted to " + session.requester.getName() + " for "
+                + GRANT_SECONDS + " seconds.");
+        broadcast(game, session);
+    }
+
+    private static void expireLater(final Game game, final Session session) {
+        synchronized (TakeBackCoordinator.class) {
+            expire(game, session);
+        }
+    }
+
+    private static void expire(final Game game, final Session session) {
+        if (session.phase != TakeBackMessage.Phase.GRANTED) {
+            return;
+        }
+        end(game, session, TakeBackMessage.Phase.EXPIRED, "The take-back window closed.");
+    }
+
+    private static void timeOut(final Game game, final Session session) {
+        synchronized (TakeBackCoordinator.class) {
+            if (session.phase != TakeBackMessage.Phase.VOTING) {
+                return;
+            }
+            end(game, session, TakeBackMessage.Phase.TIMED_OUT, "Nobody answered the take-back request.");
+        }
+    }
+
+    private static void end(final Game game, final Session session, final TakeBackMessage.Phase phase,
+            final String message) {
+        session.cancelAlarm();
+        session.phase = phase;
+        session.deadlineMs = 0;
+        if (SESSIONS.get(game) == session) {
+            SESSIONS.remove(game); // a late alarm must not clear a newer request
+        }
+        log(game, message);
+        broadcast(game, session);
+    }
+
+    private static void broadcast(final Game game, final Session session) {
+        final List<TakeBackMessage.Entry> entries = new ArrayList<>();
+        for (final Map.Entry<Player, TakeBackMessage.Vote> e : session.votes.entrySet()) {
+            if (game.getPlayers().contains(e.getKey())) {
+                entries.add(new TakeBackMessage.Entry(e.getKey().getView(), e.getValue()));
+            }
+        }
+        final TakeBackMessage.Status update = new TakeBackMessage.Status(
+                session.requester.getView(), entries, session.phase, session.secondsLeft());
+        for (final Player p : game.getRegisteredPlayers()) {
+            if (p.getController() instanceof PlayerControllerHuman pch) {
+                final IGuiGame gui = pch.getGui();
+                if (gui != null) {
+                    gui.updateTakeBack(update);
+                }
+            }
+        }
+    }
+
+    private static void log(final Game game, final String message) {
+        game.getGameLog().add(GameLogEntryType.INFORMATION, message);
+    }
+}
diff --git a/forge-gui/src/main/java/forge/gamemodes/match/TakeBackMessage.java b/forge-gui/src/main/java/forge/gamemodes/match/TakeBackMessage.java
new file mode 100644
index 0000000000..a211d291b9
--- /dev/null
+++ b/forge-gui/src/main/java/forge/gamemodes/match/TakeBackMessage.java
@@ -0,0 +1,84 @@
+package forge.gamemodes.match;
+
+import java.io.Serializable;
+import java.util.List;
+
+import forge.game.player.PlayerView;
+
+/**
+ * Take-back protocol payloads: the client {@link Action} and {@link Tool} commands and the
+ * server {@link Status} snapshot of the request.
+ */
+public final class TakeBackMessage {
+    private TakeBackMessage() {}
+
+    /** Client -> server command. */
+    public enum Action { REQUEST, ACCEPT, DECLINE, FINISH }
+
+    /** One opponent's answer to a request. */
+    public enum Vote { PENDING, ACCEPTED, DECLINED }
+
+    /** Where a request is in its life cycle. */
+    public enum Phase {
+        VOTING,
+        GRANTED,
+        /** Somebody voted no. */
+        DECLINED,
+        /** Nobody voted in time. */
+        TIMED_OUT,
+        /** The requester pressed Done. */
+        FINISHED,
+        /** The window ran out. */
+        EXPIRED
+    }
+
+    /** The curated board fix-ups a player may run while a take-back is granted. */
+    public enum Tool {
+        UNTAP("Untap permanents", "Pick permanents to untap."),
+        TAP("Tap permanents", "Pick permanents to tap."),
+        MOVE_CARD("Move a card", "Move one card to another zone."),
+        SET_LIFE("Set life total", "Set a player's life to a number."),
+        ADD_COUNTERS("Add counters", "Put counters on a permanent."),
+        REMOVE_COUNTERS("Remove counters", "Take counters off a permanent."),
+        MANA("Refill mana", "Add mana of every color to the pool of the player with priority.");
+
+        private final String label;
+        private final String hint;
+
+        Tool(final String label, final String hint) {
+            this.label = label;
+            this.hint = hint;
+        }
+
+        public String getLabel() {
+            return label;
+        }
+
+        public String getHint() {
+            return hint;
+        }
+    }
+
+    public record Entry(PlayerView player, Vote vote) implements Serializable {}
+
+    /**
+     * Server -> client snapshot: who asked, how every other human voted, where the request
+     * stands and how many seconds are left on the current clock (voting or granted window).
+     */
+    public record Status(PlayerView requester, List<Entry> entries, Phase phase, int secondsLeft)
+            implements Serializable {
+        public boolean isPending(final PlayerView player) {
+            return player != null && entries.stream()
+                    .anyMatch(e -> player.equals(e.player()) && e.vote() == Vote.PENDING);
+        }
+
+        public boolean isRequester(final PlayerView player) {
+            return player != null && player.equals(requester);
+        }
+
+        /** True once the request is over, however it ended. */
+        public boolean isOver() {
+            return phase != Phase.VOTING && phase != Phase.GRANTED;
+        }
+    }
+}
