+    @Override
+    public void updateTakeBack(final TakeBackMessage.Status update) {
+        FThreads.invokeInEdtNowOrLater(() -> {
+            final PlayerView local = localPlayerFor(update);
+            if (update.isOver()) {
+                // Only tell the players who still have the dialog open; a player who already
+                // voted or pressed Done has dismissed it and doesn't need it back.
+                if (takeBackDialog != null) {
+                    if (takeBackDialog.isVisible()) {
+                        takeBackDialog.refresh(update, local);
+                    } else {
+                        takeBackDialog.dispose();
+                    }
+                    takeBackDialog = null;
+                }
+                return;
+            }
+            if (takeBackDialog == null) {
+                takeBackDialog = new VTakeBackDialog(this);
+            }
+            takeBackDialog.refresh(update, local);
+        });
+    }
+
+    /** The local player this take-back concerns: the one who owes a vote, else the requester. */
+    private PlayerView localPlayerFor(final TakeBackMessage.Status update) {
+        for (final PlayerView lp : getLocalPlayers()) {
+            if (update.isPending(lp)) {
+                return lp;
+            }
+        }
+        for (final PlayerView lp : getLocalPlayers()) {
+            if (update.isRequester(lp)) {
+                return lp;
+            }
+        }
+        return null;
+    }
 
